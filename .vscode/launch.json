{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Run Project",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "DB Studio",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "drizzle-kit",
        "studio"
      ],
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Run Blog Cron (generate-blog)",
      "program": "${workspaceFolder}/scripts/generate-blog.js",
      "cwd": "${workspaceFolder}",
      "runtimeArgs": ["-r", "dotenv/config"],
      "envFile": "${workspaceFolder}/.env",
      "outputCapture": "std"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Run News Blog Cron (generate-news-blog)",
      "program": "${workspaceFolder}/scripts/generate-news-blog.js",
      "cwd": "${workspaceFolder}",
      "runtimeArgs": ["-r", "dotenv/config"],
      "envFile": "${workspaceFolder}/.env",
      "outputCapture": "std"
    }
  ]
}
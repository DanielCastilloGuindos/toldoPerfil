---
import { ClientRouter } from "astro:transitions";

import SEO, { type Preload } from "@/components/SEO.astro";
import Header from "@/sections/Header.astro";
import Footer from "@/sections/Footer.astro";

interface Props {
	title: string;
	description: string;
	preload?: Array<Preload>;
	canonical?: string;
	image?: string;
	isVisibleNav?: boolean;
}

const {
	title,
	description,
	preload,
	image,
	canonical = "https://toldoperfil.es",
} = Astro.props;
---

<!doctype html>
<html lang="es" transition:animate="none">
	<head>
		<SEO
			canonical={canonical}
			description={description}
			image={image}
			preload={preload}
			title={title}
		/>

		<ClientRouter />
	</head>
	<body transition:name="body">
		<Header isVisibleNav={Astro.props.isVisibleNav || false} />
		<slot />
		<Footer />
	</body>
</html>
<style is:global>
	:root {
		--color-primary: #ddd;
		--color-secondary: #333;
		--color-accent: #301dff;
		--color-accent-rgb: 213, 255, 0;

		--background-color: #f5f4ff;
		--background-twitch: var(--color-twitch-ice);

		--color-twitch: #9146ff;
		--color-twitch-ice: #f0f0ff;
	}
	html {
		font-family: system-ui, sans-serif;
		background: var(--background-color);
		scrollbar-gutter: stable;
		-webkit-font-smoothing: antialiased;
		color: #3d3d3d;
	}

	body {
		@apply flex flex-col justify-start h-fit min-h-lvh;
	}

	main {
		position: relative;
	}

	@supports selector(::-webkit-scrollbar) {
		::-webkit-scrollbar {
			width: 10px;
			border-radius: 10px;
		}

		::-webkit-scrollbar-thumb {
			border-radius: 10px;
			background-color: theme("colors.primary");
			border: 2px solid transparent;
			background-clip: content-box;
		}

		::-webkit-scrollbar-thumb:active {
			background-color: #666;
		}

		::-webkit-scrollbar-track {
			background: var(--background-image);
		}

		::-webkit-scrollbar-corner {
			background: var(--background-image);
		}
	}

	@supports not selector(::-webkit-scrollbar) {
		* {
			scrollbar-color: theme("colors.primary") transparent;
			scrollbar-width: thin;
		}
	}
	.button,
	dialog {
		@apply text-indigo-900 border-2 border-indigo-900 rounded;
		box-shadow:
			0 2px 4px 0 rgba(136, 144, 195, 0.2),
			0 5px 15px 0 rgba(37, 44, 97, 0.15);
	}
	.secondary-button {
		@apply text-white border-2 border-indigo-900 bg-indigo-950 rounded;
		box-shadow:
			0 2px 4px 0 rgba(136, 144, 195, 0.2),
			0 5px 15px 0 rgba(37, 44, 97, 0.15);
	}

	@keyframes scrollEffect {
		from {
			opacity: 0;
			scale: 25%;
		}
		to {
			opacity: 1;
			scale: 100%;
		}
	}

	.scroll-effect {
		view-timeline-name: --section;
		view-timeline-axis: block;
		animation-timeline: --section;
		animation-name: scrollEffect;
		animation-range: entry 10% cover 30%;
		animation-fill-mode: both;
	}

	::view-transition-group(*) {
		animation-duration: .5s;
		animation-fill-mode: both;
	}

	/* Desactivar la transición de página por defecto del root para evitar saltos de scroll */
	::view-transition-old(root),
	::view-transition-new(root) {
		animation: none !important;
		mix-blend-mode: normal !important;
	}

	/* Animación Hover de Workspace Items (Áreas de trabajo / Product Cards) */
	@media (min-width: 640px) {
		.workspace-title,
		.workspace-subtitle {
			opacity: 0;
			transform: translateY(-20px);
			transition-property: transform, opacity;
			transition-duration: 400ms;
			transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
		}

		/* Estado NO Hover (Hover out / Reversa):
		   El subtítulo desaparece rápido (sin delay), y el título después (delay de 150ms) */
		.group .workspace-subtitle {
			transition-delay: 0ms;
		}
		.group .workspace-title {
			transition-delay: 150ms;
		}

		/* Estado Hover (Entrada):
		   El título aparece rápido (delay de 100ms), y el subtítulo después (delay de 250ms) */
		.group:hover .workspace-title {
			opacity: 1;
			transform: translateY(0);
			transition-delay: 100ms;
		}
		.group:hover .workspace-subtitle {
			opacity: 1;
			transform: translateY(0);
			transition-delay: 250ms;
		}
	}
</style>

<script>
	// Simple Analytics Tracking
	const trackPageView = async () => {
		try {
			await fetch("/api/analytics/track", {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({
					type: "page_view",
					data: {
						path: window.location.pathname,
						referrer: document.referrer,
					},
				}),
			});
		} catch (e) {
			console.error("Analytics Error", e);
		}
	};

	// Run on load (and on view transitions if used, but simple is fine for now)
	document.addEventListener("astro:page-load", trackPageView);
	// Fallback if view transitions are not fully active or for initial load
	if (!document.documentElement.dataset.astroTransitionInitial) {
		trackPageView();
	}
</script>

---
export const prerender = true;

import { brandsAndFranchisesCustomers as bafCustomers, getStaticProductsPaths } from "@/consts/customers";

import ClientLayout from '@/layouts/ClientLayout.astro';

import Header from '@/sections/clients/Header.astro';
import InfoGalery from '@/sections/clients/Info&Galery.astro';

export function getStaticPaths() {
	return getStaticProductsPaths();
}

const { clientId } = Astro.params;

const selectedClient = bafCustomers.find(client => client.id === clientId );
---

<ClientLayout
	description={`Fabricación y montaje de toldos y cerramientos corporativos a medida realizado para la marca ${selectedClient.title}. Sistemas de protección solar en la Comunidad de Madrid.`}
	title={`Instalación de toldo para ${selectedClient.title} | Toldo Perfil`} 
	canonical={`https://toldoperfil.es/products/${clientId}`}
>
	<main class="font-sans">
		<Header title={ selectedClient.title } transitionName= { "title_" + selectedClient.id } />
		<InfoGalery data={ selectedClient } /> 
	</main>
</ClientLayout>
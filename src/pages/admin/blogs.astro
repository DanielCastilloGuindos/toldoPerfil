                                                <form method="POST" class="inline">
                                                    <input type="hidden" name="action" value="delete" />
                                                    <input type="hidden" name="blogId" value={blog.id} />
                                                    <button 
                                                        type="button" 
                                                        class="confirm-trigger-btn p-2 bg-red-500/10 hover:bg-red-500/20 text-red-400 rounded-lg border border-red-500/20 transition-colors" 

---
import Layout from "@/layouts/AdminLayout.astro";
import LoginForm from "@/components/admin/LoginForm.astro";
import { getAllSections } from "@/utils/sections";

const cookie = Astro.cookies.get("admin_session");
const isAuthenticated = cookie?.value === "authenticated";

// Obtener y agrupar secciones para visualización limpia
let sections: any[] = [];
if (isAuthenticated) {
    const rawSections = await getAllSections();
    const groupedMap = new Map();
    
    for (const sec of rawSections) {
        if (!groupedMap.has(sec.type)) {
            groupedMap.set(sec.type, {
                id: sec.id,
                type: sec.type,
                isEnabled: sec.isEnabled,
                order: sec.order,
                count: 0,
                title: sec.data.title || null
            });
        }
        const group = groupedMap.get(sec.type);
        group.count++;
        // Usamos el orden mínimo como posición de referencia del grupo
        if (sec.order < group.order) {
            group.order = sec.order;
        }
        // El estado del grupo es el del elemento
        group.isEnabled = sec.isEnabled;
    }
    
    sections = Array.from(groupedMap.values()).sort((a, b) => a.order - b.order);
}

// Configuración visual de cada tipo de sección
const SECTION_META: Record<string, { title: string; desc: string; icon: string; badgeColor: string; editUrl: string }> = {
    carousel_slide: {
        title: "Hero / Carrusel",
        desc: "Diapositivas gigantes con títulos, descripciones y botones de llamada a la acción.",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>`,
        badgeColor: "bg-indigo-500/10 text-indigo-300 border-indigo-500/20",
        editUrl: "/admin/sections/carousel"
    },
    about: {
        title: "Sobre Nosotros (Info)",
        desc: "Historia, valores y estadísticas principales de la empresa.",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
        badgeColor: "bg-emerald-500/10 text-emerald-300 border-emerald-500/20",
        editUrl: "/admin/sections/about"
    },
    gallery_enterprise: {
        title: "Galería Empresas",
        desc: "Título y descripción del bloque de clientes comerciales y primeras marcas.",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>`,
        badgeColor: "bg-amber-500/10 text-amber-300 border-amber-500/20",
        editUrl: "/admin/sections/gallery/enterprise"
    },
    communities: {
        title: "Comunidades",
        desc: "Servicios orientados a comunidades de vecinos, administradores y constructoras.",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>`,
        badgeColor: "bg-cyan-500/10 text-cyan-300 border-cyan-500/20",
        editUrl: "/admin/sections/communities"
    },
    gallery_private: {
        title: "Galería Particulares",
        desc: "Título y descripción del bloque de instalaciones residenciales y particulares.",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>`,
        badgeColor: "bg-purple-500/10 text-purple-300 border-purple-500/20",
        editUrl: "/admin/sections/gallery/private"
    },
    products_split: {
        title: "Amplia Gama de Productos",
        desc: "Listado de servicios (check/números) junto a una imagen lateral descriptiva.",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>`,
        badgeColor: "bg-rose-500/10 text-rose-300 border-rose-500/20",
        editUrl: "/admin/sections/products"
    },
    faq: {
        title: "Preguntas Frecuentes (FAQs)",
        desc: "Acordeón interactivo de preguntas y respuestas frecuentes.",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-orange-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
        badgeColor: "bg-orange-500/10 text-orange-300 border-orange-500/20",
        editUrl: "/admin/sections/faqs"
    }
};
---

<Layout
    description="Gestión de Secciones - Toldo Perfil"
    title="Gestionar Estructura - Toldo Perfil"
    canonical="https://toldoperfil.es"
>
    <main class="font-sans min-h-screen">
        {isAuthenticated ? (
            <div class="fixed inset-0 -z-10 bg-neutral-900">
                <div class="absolute inset-0 bg-[url('/img/carousel/protrait02.webp')] bg-cover bg-center opacity-20 blur-sm scale-105"></div>
                <div class="absolute inset-0 bg-neutral-900/80 mix-blend-multiply"></div>
            </div>

            <div class="text-white p-6 max-w-5xl mx-auto space-y-8">
                <!-- Header -->
                <header class="flex flex-col md:flex-row justify-between items-center gap-4 bg-white/10 backdrop-blur-xl border border-white/10 rounded-2xl shadow-2xl px-6 py-4">
                    <div class="flex items-center gap-4">
                        <a href="/admin" class="p-2 bg-white/5 hover:bg-white/10 rounded-lg transition-colors border border-white/10">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-indigo-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                            </svg>
                        </a>
                        <div>
                            <h1 class="text-xl font-bold tracking-tight">Estructura de la Web</h1>
                            <p class="text-xs text-indigo-200">Reordena y activa secciones de la página de inicio</p>
                        </div>
                    </div>
                    <div class="text-right relative inline-block" id="add-menu-container">
                        <button
                            type="button"
                            id="add-dropdown-btn"
                            class="px-4 py-2.5 bg-indigo-600 hover:bg-indigo-500 hover:-translate-y-0.5 active:translate-y-0 text-white rounded-xl text-xs font-bold shadow-lg shadow-indigo-500/20 transition-all flex items-center gap-2 cursor-pointer"
                        >
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                            </svg>
                            Añadir Componente
                        </button>
                        
                        <div 
                            id="add-dropdown-menu" 
                            class="hidden absolute right-0 mt-2 w-48 bg-neutral-900 border border-white/10 rounded-xl shadow-2xl py-1.5 z-50 transition-all transform origin-top-right scale-95 opacity-0"
                        >
                            <button data-type="flexible" class="w-full text-left px-4 py-2 text-xs text-neutral-300 hover:bg-indigo-600 hover:text-white transition-colors cursor-pointer font-bold flex items-center gap-2">
                                <span>✨</span> Sección Flexible
                            </button>
                            <button data-type="gallery" class="w-full text-left px-4 py-2 text-xs text-neutral-300 hover:bg-indigo-600 hover:text-white transition-colors cursor-pointer font-bold flex items-center gap-2">
                                <span>🖼️</span> Sección Galería
                            </button>
                            <button data-type="faq_block" class="w-full text-left px-4 py-2 text-xs text-neutral-300 hover:bg-indigo-600 hover:text-white transition-colors cursor-pointer font-bold flex items-center gap-2">
                                <span>❓</span> Bloque de FAQs
                            </button>
                            <button data-type="form" class="w-full text-left px-4 py-2 text-xs text-neutral-300 hover:bg-indigo-600 hover:text-white transition-colors cursor-pointer font-bold flex items-center gap-2">
                                <span>📝</span> Formulario de Contacto
                            </button>
                        </div>
                    </div>
                </header>

                <div class="bg-indigo-950/40 border border-indigo-500/10 rounded-2xl p-4 flex gap-3 items-start">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-indigo-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <p class="text-xs text-indigo-200 leading-relaxed">
                        <strong>Nota de generación:</strong> Reordenar o desactivar las secciones aquí las guardará en la base de datos de inmediato. No obstante, al tratarse de un sitio estático altamente optimizado, las modificaciones se visualizarán públicamente una vez que se ejecute la próxima <strong>build de Vercel</strong>.
                    </p>
                </div>

                <!-- Lista de Secciones con DnD -->
                <div class="bg-neutral-900/60 backdrop-blur-md border border-white/10 rounded-2xl overflow-hidden shadow-xl p-4">
                    <ul id="sections-list" class="space-y-3">
                        {sections.map((sec) => {
                            let editUrl = `/admin/sections/edit/${sec.id}`;
                            let meta = {
                                title: sec.title || "Componente Personalizado",
                                desc: "Componente dinámico personalizado.",
                                icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" /></svg>`,
                                badgeColor: "bg-neutral-500/10 text-neutral-300 border-neutral-500/20",
                                editUrl
                            };

                            if (SECTION_META[sec.type]) {
                                meta = {
                                    ...SECTION_META[sec.type],
                                    title: sec.title || SECTION_META[sec.type].title,
                                    editUrl: SECTION_META[sec.type].editUrl
                                };
                            } else if (sec.type.startsWith("flexible_")) {
                                meta = {
                                    title: sec.title || "Sección Flexible",
                                    desc: "Componente con diseño responsivo, Markdown, checklist, FAQs, etc.",
                                    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" /></svg>`,
                                    badgeColor: "bg-emerald-500/10 text-emerald-300 border-emerald-500/20",
                                    editUrl
                                };
                            } else if (sec.type.startsWith("gallery_")) {
                                meta = {
                                    title: sec.title || "Galería de Trabajos",
                                    desc: "Muestra carruseles o mosaicos de proyectos residenciales o empresariales.",
                                    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>`,
                                    badgeColor: "bg-amber-500/10 text-amber-300 border-amber-500/20",
                                    editUrl
                                };
                            } else if (sec.type.startsWith("faq_block_")) {
                                meta = {
                                    title: sec.title || "Bloque de FAQs",
                                    desc: "Acordeón interactivo de preguntas y respuestas frecuentes locales.",
                                    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-orange-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
                                    badgeColor: "bg-orange-500/10 text-orange-300 border-orange-500/20",
                                    editUrl
                                };
                            } else if (sec.type.startsWith("form_")) {
                                meta = {
                                    title: sec.title || "Formulario de Contacto",
                                    desc: "Sección con formulario de contacto y enlaces de redes sociales.",
                                    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>`,
                                    badgeColor: "bg-rose-500/10 text-rose-300 border-rose-500/20",
                                    editUrl
                                };
                            }
                            return (
                                <li 
                                    data-type={sec.type}
                                    draggable="true" 
                                    class="section-item flex flex-col sm:flex-row sm:items-center justify-between p-4 gap-4 bg-white/5 border border-white/5 rounded-xl hover:border-white/10 hover:bg-white/10 transition-all duration-200 group cursor-grab active:cursor-grabbing"
                                >
                                    <div class="flex items-center gap-4 min-w-0 w-full sm:w-auto">
                                        <!-- Drag handle icon -->
                                        <div class="text-neutral-500 group-hover:text-indigo-400 transition-colors select-none font-mono text-lg shrink-0">
                                            ⣿
                                        </div>
                                        <div class="shrink-0 select-none w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center group-hover:scale-105 transition-transform duration-300">
                                            <Fragment set:html={meta.icon} />
                                        </div>
                                        <div class="min-w-0 flex-1">
                                            <div class="flex items-center gap-2 flex-wrap">
                                                <h3 class="font-bold text-white text-sm">{meta.title}</h3>
                                                <span class={`px-2 py-0.5 rounded text-[9px] font-bold uppercase border ${meta.badgeColor}`}>
                                                    {sec.count > 1 ? `${sec.count} elementos` : "único"}
                                                </span>
                                            </div>
                                            <p class="text-xs text-neutral-400 line-clamp-1 mt-0.5">{meta.desc}</p>
                                        </div>
                                    </div>

                                    <div class="flex items-center justify-end gap-2 w-full sm:w-auto border-t border-white/5 sm:border-t-0 pt-3 sm:pt-0 shrink-0">
                                        <!-- Toggle Eye Button -->
                                        <label 
                                            class="relative inline-flex items-center justify-center p-2 rounded-lg border transition-all cursor-pointer select-none text-xs font-semibold"
                                            class:list={[
                                                sec.isEnabled 
                                                    ? "bg-emerald-600/10 hover:bg-emerald-600/20 text-emerald-400 border-emerald-500/20 hover:scale-105 active:scale-95" 
                                                    : "bg-red-600/10 hover:bg-red-600/20 text-red-400 border-red-500/20 hover:scale-105 active:scale-95"
                                            ]}
                                            title={sec.isEnabled ? "Visible (Click para ocultar)" : "Oculto (Click para mostrar)"}
                                        >
                                            <input 
                                                type="checkbox" 
                                                class="sr-only toggle-section-state" 
                                                data-type={sec.type}
                                                checked={sec.isEnabled}
                                            />
                                            <!-- Eye open -->
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 eye-open-icon" class:list={[{ "hidden": !sec.isEnabled }]} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                            </svg>
                                            <!-- Eye off -->
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 eye-closed-icon" class:list={[{ "hidden": sec.isEnabled }]} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
                                            </svg>
                                        </label>

                                        <!-- Edit button -->
                                        <a 
                                            href={meta.editUrl} 
                                            title="Editar Sección"
                                            class="p-2 bg-indigo-600/20 hover:bg-indigo-600/40 text-indigo-300 hover:text-white rounded-lg border border-indigo-500/20 transition-all text-xs font-semibold flex items-center justify-center hover:scale-105 active:scale-95"
                                        >
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                            </svg>
                                        </a>

                                        <!-- Delete button -->
                                        { (sec.type.startsWith("flexible_") || sec.type.startsWith("gallery_") || sec.type.startsWith("faq_block_") || sec.type.startsWith("form_")) && (
                                            <button
                                                type="button"
                                                data-id={sec.id}
                                                class="p-2 bg-red-600/10 hover:bg-red-600/30 text-red-400 rounded-lg border border-red-500/20 hover:scale-105 active:scale-95 transition-all delete-section-btn cursor-pointer"
                                                title="Eliminar Sección"
                                            >
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                </svg>
                                            </button>
                                        )}
                                    </div>
                                </li>
                            );
                        })}
                    </ul>
                </div>
            </div>

            <!-- Toast de Guardado -->
            <div id="toast-success" class="fixed bottom-6 right-6 transform translate-y-12 opacity-0 pointer-events-none bg-emerald-500 text-white px-4 py-3 rounded-xl shadow-xl flex items-center gap-2 transition-all duration-300 z-50">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span class="text-xs font-bold" id="toast-message">Cambios guardados con éxito</span>
            </div>

            <!-- Modal para confirmar eliminación de sección -->
            <dialog id="delete-section-modal" class="bg-neutral-900 border border-white/10 rounded-2xl p-6 text-white max-w-sm w-full backdrop:bg-black/60 shadow-2xl">
                <h3 class="text-base font-bold mb-2 text-red-400">¿Eliminar esta sección?</h3>
                <p class="text-xs text-neutral-400 leading-relaxed mb-6">
                    Esta acción es irreversible y removerá permanentemente esta sección y todo su contenido del sitio.
                </p>
                <div class="flex justify-end gap-3">
                    <button id="cancel-delete-section-btn" class="px-4 py-2 bg-white/5 hover:bg-white/10 text-white rounded-xl text-xs font-semibold cursor-pointer">
                        Cancelar
                    </button>
                    <button id="confirm-delete-section-btn" class="px-4 py-2 bg-red-600 hover:bg-red-500 text-white rounded-xl text-xs font-bold shadow-lg shadow-red-600/20 cursor-pointer">
                        Confirmar Eliminar
                    </button>
                </div>
            </dialog>


        ) : (
            <LoginForm />
        )}
    </main>

    <script>
        import { $$, $ } from "@/consts/dom-selector";

        function showToast(message: string) {
            const toast = document.getElementById('toast-success');
            const toastMsg = document.getElementById('toast-message');
            if (!toast || !toastMsg) return;

            toastMsg.textContent = message;
            toast.classList.remove('translate-y-12', 'opacity-0', 'pointer-events-none');
            toast.classList.add('translate-y-0', 'opacity-100');

            setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('translate-y-12', 'opacity-0', 'pointer-events-none');
            }, 3000);
        }

        function initDragAndDrop() {
            const list = document.getElementById('sections-list');
            if (!list) return;

            let dragEl: HTMLElement | null = null;

            list.addEventListener('dragstart', (e: any) => {
                dragEl = e.target.closest('.section-item');
                if (dragEl) {
                    dragEl.classList.add('opacity-55');
                    e.dataTransfer.effectAllowed = 'move';
                }
            });

            list.addEventListener('dragover', (e: any) => {
                e.preventDefault();
                const target = e.target.closest('.section-item');
                if (target && target !== dragEl && dragEl) {
                    const bounding = target.getBoundingClientRect();
                    const offset = e.clientY - bounding.top - (bounding.height / 2);
                    if (offset > 0) {
                        target.after(dragEl);
                    } else {
                        target.before(dragEl);
                    }
                }
            });

            list.addEventListener('dragend', async () => {
                if (dragEl) {
                    dragEl.classList.remove('opacity-55');
                }

                // Obtener todos los tipos en el nuevo orden
                const items = list.querySelectorAll('.section-item');
                const types = Array.from(items).map((item: any) => item.getAttribute('data-type'));

                try {
                    const res = await fetch('/api/sections/reorder', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ types })
                    });
                    const result = await res.json();
                    if (result.success) {
                        showToast('Orden de las secciones guardado');
                    } else {
                        console.error('Error al guardar orden:', result.error);
                    }
                } catch (e) {
                    console.error('Error en fetch reorder:', e);
                }
            });
        }

        function initToggles() {
            const toggles = $$('.toggle-section-state');
            toggles.forEach((checkbox: any) => {
                checkbox.addEventListener('change', async () => {
                    const type = checkbox.getAttribute('data-type');
                    const isEnabled = checkbox.checked;
                    const label = checkbox.closest('label');
                    const eyeOpen = label?.querySelector('.eye-open-icon');
                    const eyeClosed = label?.querySelector('.eye-closed-icon');

                    const updateVisuals = (active: boolean) => {
                        if (label) {
                            if (active) {
                                label.className = "relative inline-flex items-center justify-center p-2 rounded-lg border transition-all cursor-pointer select-none text-xs font-semibold bg-emerald-600/10 hover:bg-emerald-600/20 text-emerald-400 border-emerald-500/20 hover:scale-105 active:scale-95";
                                label.setAttribute('title', 'Visible (Click para ocultar)');
                                eyeOpen?.classList.remove('hidden');
                                eyeClosed?.classList.add('hidden');
                            } else {
                                label.className = "relative inline-flex items-center justify-center p-2 rounded-lg border transition-all cursor-pointer select-none text-xs font-semibold bg-red-600/10 hover:bg-red-600/20 text-red-400 border-red-500/20 hover:scale-105 active:scale-95";
                                label.setAttribute('title', 'Oculto (Click para mostrar)');
                                eyeOpen?.classList.add('hidden');
                                eyeClosed?.classList.remove('hidden');
                            }
                        }
                    };

                    updateVisuals(isEnabled);

                    try {
                        const res = await fetch('/api/sections/toggle', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ type, isEnabled })
                        });
                        const result = await res.json();
                        if (result.success) {
                            showToast(isEnabled ? 'Sección activada' : 'Sección desactivada');
                        } else {
                            checkbox.checked = !isEnabled; // Revertir si hay error
                            updateVisuals(!isEnabled);
                            console.error('Error al alternar estado:', result.error);
                        }
                    } catch (e) {
                        checkbox.checked = !isEnabled; // Revertir
                        updateVisuals(!isEnabled);
                        console.error('Error en fetch toggle:', e);
                    }
                });
            });
        }

        function initCreateDropdown() {
            const dropdownBtn = document.getElementById('add-dropdown-btn');
            const dropdownMenu = document.getElementById('add-dropdown-menu');
            if (!dropdownBtn || !dropdownMenu) return;

            dropdownBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                const isHidden = dropdownMenu.classList.contains('hidden');
                if (isHidden) {
                    dropdownMenu.classList.remove('hidden');
                    // Force a reflow for transition
                    dropdownMenu.offsetHeight;
                    dropdownMenu.classList.remove('scale-95', 'opacity-0');
                    dropdownMenu.classList.add('scale-100', 'opacity-100');
                } else {
                    closeDropdown();
                }
            });

            const closeDropdown = () => {
                dropdownMenu.classList.remove('scale-100', 'opacity-100');
                dropdownMenu.classList.add('scale-95', 'opacity-0');
                setTimeout(() => {
                    dropdownMenu.classList.add('hidden');
                }, 150);
            };

            document.addEventListener('click', () => {
                if (!dropdownMenu.classList.contains('hidden')) {
                    closeDropdown();
                }
            });

            // Handle dropdown item clicks
            const buttons = dropdownMenu.querySelectorAll('button[data-type]');
            buttons.forEach((btn: any) => {
                btn.addEventListener('click', async (e: any) => {
                    e.preventDefault();
                    const type = btn.getAttribute('data-type');
                    try {
                        const res = await fetch('/api/sections/create', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ type })
                        });
                        const result = await res.json();
                        if (result.success && result.id) {
                            window.location.href = `/admin/sections/edit/${result.id}`;
                        } else {
                            alert('Error al crear sección: ' + (result.error || 'Desconocido'));
                        }
                    } catch (err) {
                        console.error('Error al crear sección:', err);
                        alert('Error de conexión al crear sección');
                    }
                });
            });
        }

        function initDeleteSection() {
            const deleteButtons = $$('.delete-section-btn');
            const modal = document.getElementById('delete-section-modal') as HTMLDialogElement;
            const cancelBtn = document.getElementById('cancel-delete-section-btn');
            const confirmBtn = document.getElementById('confirm-delete-section-btn');
            
            if (!modal || !cancelBtn || !confirmBtn) return;

            let sectionIdToDelete: string | null = null;

            deleteButtons.forEach((btn: any) => {
                btn.addEventListener('click', () => {
                    sectionIdToDelete = btn.getAttribute('data-id');
                    modal.showModal();
                });
            });

            cancelBtn.addEventListener('click', () => {
                modal.close();
                sectionIdToDelete = null;
            });

            confirmBtn.addEventListener('click', async () => {
                if (!sectionIdToDelete) return;
                try {
                    const res = await fetch('/api/sections/delete', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ id: sectionIdToDelete })
                    });
                    const result = await res.json();
                    if (result.success) {
                        window.location.reload();
                    } else {
                        alert('Error al eliminar sección: ' + (result.error || 'Desconocido'));
                    }
                } catch (e) {
                    console.error(e);
                    alert('Error al eliminar la sección');
                } finally {
                    modal.close();
                    sectionIdToDelete = null;
                }
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            initDragAndDrop();
            initToggles();
            initCreateDropdown();
            initDeleteSection();
        });
        document.addEventListener('astro:page-load', () => {
            initDragAndDrop();
            initToggles();
            initCreateDropdown();
            initDeleteSection();
        });
    </script>
</Layout>

---
import Layout from "@/layouts/AdminLayout.astro";
import LoginForm from "@/components/admin/LoginForm.astro";
import { db } from "@/db/client";
import { Blogs } from "@/db/schema";
import { eq } from "drizzle-orm";

const { id } = Astro.params;

if (!id) {
    return Astro.redirect("/admin/blogs");
}

const cookie = Astro.cookies.get("admin_session");
const isAuthenticated = cookie?.value === "authenticated";

// Fetch the existing blog post
let blog;
try {
    const result = await db.select().from(Blogs).where(eq(Blogs.id, Number(id)));
    blog = result[0];
} catch (e) {
    console.error("Error fetching blog post for editing:", e);
}

if (!blog) {
    return Astro.redirect("/admin/blogs");
}

// Handle POST request to update the blog post
if (isAuthenticated && Astro.request.method === "POST") {
    try {
        const data = await Astro.request.formData();
        const title = data.get("title")?.toString() || "";
        let slug = data.get("slug")?.toString() || "";
        const description = data.get("description")?.toString() || "";
        const content = data.get("content")?.toString() || "";
        const isVisible = data.get("isVisible") === "true";
        const publishedAtStr = data.get("publishedAt")?.toString();

        if (!slug) {
            slug = title
                .toLowerCase()
                .normalize("NFD")
                .replace(/[\u0300-\u036f]/g, "") // remove accents
                .replace(/[^a-z0-9]+/g, '-')     // replace spaces with hyphens
                .replace(/(^-|-$)+/g, '');       // remove trailing/leading hyphens
        }

        const publishedAt = publishedAtStr ? new Date(publishedAtStr) : new Date();

        await db.update(Blogs)
            .set({
                title,
                slug,
                description,
                content,
                isVisible,
                publishedAt
            })
            .where(eq(Blogs.id, Number(id)));

        return Astro.redirect("/admin/blogs");
    } catch (e) {
        console.error("Error updating blog post:", e);
        return new Response(`Error al actualizar el artículo: ${e}`, { status: 400 });
    }
}

// Formats date to local ISO format for datetime-local (YYYY-MM-DDTHH:MM)
const formatPublishDate = (date: Date) => {
    try {
        const offset = date.getTimezoneOffset();
        const localDate = new Date(date.getTime() - (offset * 60 * 1000));
        return localDate.toISOString().slice(0, 16);
    } catch (e) {
        return new Date().toISOString().slice(0, 16);
    }
};

const publishDateValue = formatPublishDate(blog.publishedAt);
---

<Layout
    description="Editar artículo de blog"
    title="Editar Artículo - Toldo Perfil"
    canonical="https://toldoperfil.es"
>
    <!-- Background -->
    <div class="fixed inset-0 -z-10 bg-neutral-900">
        <div class="absolute inset-0 bg-[url('/img/carousel/protrait02.webp')] bg-cover bg-center opacity-20 blur-sm scale-105"></div>
        <div class="absolute inset-0 bg-neutral-900/80 mix-blend-multiply"></div>
    </div>

    <main class="min-h-screen flex items-center justify-center p-4">
        {isAuthenticated ? (
            <!-- Glass Card -->
            <div class="relative w-full max-w-2xl">
                <div class="absolute inset-0 bg-white/10 backdrop-blur-xl rounded-2xl border border-white/20 shadow-2xl"></div>

                <div class="relative p-8">
                    <header class="flex justify-between items-center mb-8">
                        <div>
                            <h2 class="text-2xl font-bold text-white tracking-tight">Editar Artículo</h2>
                            <p class="text-indigo-200 text-sm">Modificar artículo ID: #{blog.id}</p>
                        </div>
                        <a href="/admin/blogs" class="p-2 rounded-lg bg-white/5 hover:bg-white/10 text-indigo-200 hover:text-white transition-colors" aria-label="Volver">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        </a>
                    </header>

                    <form method="POST" class="space-y-6">
                        <!-- Title Input -->
                        <div class="space-y-2">
                            <label for="title" class="text-xs font-medium text-indigo-300 uppercase tracking-wider ml-1">Título</label>
                            <input
                                type="text"
                                id="title"
                                name="title"
                                required
                                value={blog.title}
                                class="w-full bg-neutral-950/50 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-white/20 focus:outline-none focus:border-indigo-500/50 focus:ring-1 focus:ring-indigo-500/50 transition-all"
                                placeholder="Título atractivo y SEO del artículo"
                            />
                        </div>

                        <!-- Slug Input -->
                        <div class="space-y-2">
                            <label for="slug" class="text-xs font-medium text-indigo-300 uppercase tracking-wider ml-1">Ruta URL (Slug)</label>
                            <input
                                type="text"
                                id="slug"
                                name="slug"
                                required
                                value={blog.slug}
                                class="w-full bg-neutral-950/50 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-white/20 focus:outline-none focus:border-indigo-500/50 focus:ring-1 focus:ring-indigo-500/50 transition-all font-mono text-sm"
                                placeholder="ej: tendencias-toldos-madrid-2026"
                            />
                        </div>

                        <!-- Description Input -->
                        <div class="space-y-2">
                            <label for="description" class="text-xs font-medium text-indigo-300 uppercase tracking-wider ml-1">Meta Descripción (SEO)</label>
                            <input
                                type="text"
                                id="description"
                                name="description"
                                value={blog.description}
                                class="w-full bg-neutral-950/50 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-white/20 focus:outline-none focus:border-indigo-500/50 focus:ring-1 focus:ring-indigo-500/50 transition-all"
                                placeholder="Breve resumen de menos de 150 caracteres para buscadores"
                            />
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <!-- Published At Date Input -->
                            <div class="space-y-2">
                                <label for="publishedAt" class="text-xs font-medium text-indigo-300 uppercase tracking-wider ml-1">Fecha de Publicación / Programar</label>
                                <input
                                    type="datetime-local"
                                    id="publishedAt"
                                    name="publishedAt"
                                    required
                                    value={publishDateValue}
                                    class="w-full bg-neutral-950/50 border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-indigo-500/50 focus:ring-1 focus:ring-indigo-500/50 transition-all cursor-pointer"
                                />
                            </div>

                            <!-- Visibility Checkbox -->
                            <div class="flex items-center pt-8 pl-1">
                                <label class="flex items-center cursor-pointer gap-3 text-sm text-indigo-200">
                                    <input
                                        type="checkbox"
                                        name="isVisible"
                                        value="true"
                                        checked={blog.isVisible}
                                        class="w-5 h-5 rounded bg-neutral-950/50 border border-white/10 text-indigo-600 focus:ring-indigo-500/50 focus:ring-opacity-25"
                                    />
                                    <span>Hacer visible en la web</span>
                                </label>
                            </div>
                        </div>

                        <!-- Content Input -->
                        <div class="space-y-2">
                            <label for="content" class="text-xs font-medium text-indigo-300 uppercase tracking-wider ml-1">Contenido (Soporta Markdown)</label>
                            <textarea
                                id="content"
                                name="content"
                                required
                                rows="12"
                                class="w-full bg-neutral-950/50 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-white/20 focus:outline-none focus:border-indigo-500/50 focus:ring-1 focus:ring-indigo-500/50 transition-all resize-y font-light text-sm"
                                placeholder="Escribe el artículo aquí en formato Markdown..."
                            >{blog.content}</textarea>
                        </div>

                        <!-- Submit Button -->
                        <button
                            type="submit"
                            class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-semibold py-3.5 px-4 rounded-xl shadow-lg shadow-indigo-500/30 hover:shadow-indigo-500/50 transition-all duration-300 transform hover:-translate-y-0.5 active:translate-y-0 active:shadow-none flex items-center justify-center gap-2"
                        >
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
                            </svg>
                            Guardar Cambios
                        </button>
                    </form>
                </div>
            </div>
        ) : (
            <LoginForm />
        )}
    </main>
</Layout>


---
import Layout from "@/layouts/AdminLayout.astro";
import LoginForm from "@/components/admin/LoginForm.astro";
import { db } from "@/db/client";
import { PageSections, Customers } from "@/db/schema";
import { eq, desc } from "drizzle-orm";
import { ensureDefaultSections } from "@/utils/sections";

const cookie = Astro.cookies.get("admin_session");
const isAuthenticated = cookie?.value === "authenticated";

// Asegurar seed y obtener sección
let section: any;
let projects: any[] = [];
if (isAuthenticated) {
    await ensureDefaultSections();
    const result = await db.select()
        .from(PageSections)
        .where(eq(PageSections.type, "gallery_enterprise"))
        .limit(1);
    section = result[0];

    // Obtener proyectos de empresas
    const rawProjects = await db.select()
        .from(Customers)
        .where(eq(Customers.category, "enterprise"))
        .orderBy(desc(Customers.published));
    projects = rawProjects.map(p => ({
        ...p,
        images: (p.images as string[]) || []
    }));
}

if (!section && isAuthenticated) {
    return Astro.redirect("/admin/sections");
}

const sectionData = section?.data as any;
let errorMessage = "";

if (Astro.request.method === "POST" && isAuthenticated) {
    try {
        const formData = await Astro.request.formData();
        const title = formData.get("title")?.toString().trim() || "Primeras Marcas y Franquicias";
        const heading = formData.get("heading")?.toString().trim() || "";
        const linkText = formData.get("linkText")?.toString().trim() || "Ver todos los proyectos";
        const linkHref = formData.get("linkHref")?.toString().trim() || "/proyectos/empresas";
        const isEnabled = formData.get("isEnabled") === "on";

        // Actualizar en DB
        await db.update(PageSections)
            .set({
                isEnabled: isEnabled,
                data: {
                    title,
                    heading,
                    linkText,
                    linkHref
                }
            })
            .where(eq(PageSections.type, "gallery_enterprise"));

        return Astro.redirect("/admin/sections");
    } catch (e) {
        console.error("Error al actualizar sección gallery_enterprise:", e);
        errorMessage = "Ocurrió un error inesperado al guardar los cambios.";
    }
}
---

<Layout
    description="Configurar textos Galería de Empresas - Toldo Perfil"
    title="Configurar Galería Empresas - Toldo Perfil"
    canonical="https://toldoperfil.es"
>
    <main class="font-sans min-h-screen">
        {isAuthenticated ? (
            <div class="fixed inset-0 -z-10 bg-neutral-900">
                <div class="absolute inset-0 bg-[url('/img/carousel/protrait02.webp')] bg-cover bg-center opacity-20 blur-sm scale-105"></div>
                <div class="absolute inset-0 bg-neutral-900/80 mix-blend-multiply"></div>
            </div>

            <div class="text-white p-6 max-w-2xl mx-auto space-y-8">
                <!-- Header -->
                <header class="flex items-center gap-4 bg-white/10 backdrop-blur-xl border border-white/10 rounded-2xl shadow-2xl px-6 py-4">
                    <a href="/admin/sections" class="p-2 bg-white/5 hover:bg-white/10 rounded-lg transition-colors border border-white/10">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-indigo-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                        </svg>
                    </a>
                    <div>
                        <h1 class="text-xl font-bold tracking-tight text-amber-300">Galería de Empresas</h1>
                        <p class="text-xs text-indigo-200">Configura la cabecera y el enlace de la sección de marcas comerciales</p>
                    </div>
                </header>

                {errorMessage && (
                    <div class="bg-red-500/10 border border-red-500/20 text-red-300 p-4 rounded-xl text-xs font-bold flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                        </svg>
                        <span>{errorMessage}</span>
                    </div>
                )}

                <div class="bg-amber-500/10 border border-amber-500/25 rounded-2xl p-4 flex gap-3 items-start">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-amber-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <p class="text-xs text-amber-200 leading-relaxed">
                        Este formulario modifica exclusivamente la <strong>presentación y textos envolventes</strong> del bloque de Marcas/Empresas. Las fotos de los proyectos en sí se administran desde la sección <a href="/admin/content" class="underline font-semibold hover:text-white transition-colors">Gestión de Contenido</a>.
                    </p>
                </div>

                <!-- Formulario -->
                <form method="POST" class="bg-neutral-900/60 backdrop-blur-md border border-white/10 rounded-2xl p-6 space-y-6 shadow-xl">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="space-y-2">
                            <label class="block text-xs font-bold text-indigo-200 uppercase tracking-wider">Título del Bloque</label>
                            <input 
                                type="text" 
                                name="title" 
                                value={sectionData.title || ""}
                                placeholder="Ej: Primeras Marcas y Franquiciados"
                                class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-amber-500 transition-colors"
                                required
                            />
                        </div>

                        <div class="space-y-2">
                            <label class="block text-xs font-bold text-indigo-200 uppercase tracking-wider font-semibold">Subtítulo / Introducción</label>
                            <input 
                                type="text" 
                                name="heading" 
                                value={sectionData.heading || ""}
                                placeholder="Ej: Trabajamos con primeras marcas a nivel nacional..."
                                class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-amber-500 transition-colors"
                            />
                        </div>
                    </div>

                    <hr class="border-white/5" />

                    <!-- Configuración del Botón Inferior -->
                    <div class="space-y-4">
                        <h3 class="text-xs font-bold text-amber-300 uppercase tracking-wider">Botón de Redirección Inferior</h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="space-y-2">
                                <label class="block text-[10px] font-bold text-neutral-400 uppercase tracking-wider">Texto del botón</label>
                                <input 
                                    type="text" 
                                    name="linkText" 
                                    value={sectionData.linkText || ""}
                                    placeholder="Ej: Ver todos los proyectos"
                                    class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-amber-500 transition-colors"
                                    required
                                />
                            </div>

                            <div class="space-y-2">
                                <label class="block text-[10px] font-bold text-neutral-400 uppercase tracking-wider">Destino (Ruta del botón)</label>
                                <input 
                                    type="text" 
                                    name="linkHref" 
                                    value={sectionData.linkHref || ""}
                                    placeholder="Ej: /proyectos/empresas"
                                    class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-amber-500 transition-colors"
                                    required
                                />
                            </div>
                        </div>
                    </div>

                    <hr class="border-white/5" />

                    <!-- Footer Controls -->
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <label class="relative inline-flex items-center cursor-pointer">
                                <input 
                                    type="checkbox" 
                                    name="isEnabled" 
                                    class="sr-only peer" 
                                    checked={section.isEnabled} 
                                />
                                <div class="w-9 h-5 bg-neutral-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-neutral-400 after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-amber-600 peer-checked:after:bg-white"></div>
                            </label>
                            <span class="text-xs font-semibold text-neutral-300">Activo (mostrar sección en la web)</span>
                        </div>

                        <button 
                            type="submit" 
                            class="px-6 py-3 bg-amber-600 hover:bg-amber-500 text-white rounded-xl text-xs font-bold shadow-lg shadow-amber-500/20 hover:-translate-y-0.5 active:translate-y-0 transition-all"
                        >
                            Guardar Cambios
                        </button>
                    </div>
                </form>

                <!-- Listado de Proyectos de esta Galería -->
                <div class="bg-neutral-900/60 backdrop-blur-md border border-white/10 rounded-2xl p-6 space-y-6 shadow-xl">
                    <div class="flex justify-between items-center">
                        <div>
                            <h2 class="text-md font-bold text-amber-300">Proyectos en esta Galería</h2>
                            <p class="text-xs text-neutral-400">Administra las fotos y detalles de cada instalación comercial</p>
                        </div>
                        <a 
                            href="/admin/create?category=enterprise" 
                            class="px-3.5 py-2 bg-amber-600/20 hover:bg-amber-600/40 text-amber-300 hover:text-white rounded-lg border border-amber-500/20 transition-all text-xs font-bold flex items-center gap-1.5"
                        >
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                            </svg>
                            Añadir Proyecto
                        </a>
                    </div>

                    {projects.length === 0 ? (
                        <div class="text-center py-8 text-neutral-500 text-xs">
                            No hay proyectos en esta galería de empresas.
                        </div>
                    ) : (
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            {projects.map((proj) => {
                                const images = proj.images || [];
                                const mainImg = images[0] || "/img/placeholder.webp";
                                return (
                                    <div 
                                        class="proj-item bg-white/5 border border-white/5 rounded-xl overflow-hidden hover:border-white/10 transition-all duration-200"
                                        data-id={proj.customer_id}
                                    >
                                        <div class="h-32 relative bg-neutral-800 border-b border-white/5">
                                            <img 
                                                src={mainImg} 
                                                class="w-full h-full object-cover" 
                                                alt="Proyecto de galería"
                                            />
                                            <span class="absolute top-2 right-2 bg-black/60 backdrop-blur-md text-[10px] text-white px-2 py-0.5 rounded-full font-bold border border-white/10">
                                                {images.length} foto{images.length !== 1 ? 's' : ''}
                                            </span>
                                            {!proj.isVisible && (
                                                <span class="absolute top-2 left-2 bg-red-950/80 backdrop-blur-md text-[8px] text-red-300 px-2 py-0.5 rounded-full font-bold border border-red-500/20 uppercase tracking-wider">
                                                    Oculto
                                                </span>
                                            )}
                                        </div>
                                        <div class="p-3 space-y-2">
                                            <h3 class="font-bold text-xs text-white line-clamp-1">{proj.title}</h3>
                                            
                                            <div class="flex items-center justify-between pt-1 gap-2">
                                                <!-- Link to live view -->
                                                <a 
                                                    href={`/proyectos/${proj.customer_id}`} 
                                                    target="_blank"
                                                    class="text-[10px] text-indigo-400 hover:text-indigo-300 font-semibold"
                                                >
                                                    Ver ficha →
                                                </a>

                                                <div class="flex items-center gap-1.5">
                                                    <a 
                                                        href={`/admin/edit/${proj.customer_id}`}
                                                        class="p-1.5 bg-indigo-600/20 hover:bg-indigo-600/40 text-indigo-300 hover:text-white rounded border border-indigo-500/20 transition-all"
                                                        title="Editar"
                                                    >
                                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                                        </svg>
                                                    </a>
                                                    <button 
                                                        type="button"
                                                        class="p-1.5 bg-red-600/10 hover:bg-red-600/30 text-red-400 hover:text-red-200 rounded border border-red-500/20 transition-all delete-proj-btn"
                                                        data-id={proj.customer_id}
                                                        title="Eliminar"
                                                    >
                                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                        </svg>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                );
                            })}
                        </div>
                    )}
                </div>
            </div>

            <!-- Modal de Confirmación para borrar proyecto -->
            <div id="delete-proj-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm hidden opacity-0 transition-opacity duration-300">
                <div class="bg-neutral-900 border border-white/10 rounded-2xl max-w-md w-full p-6 space-y-4 shadow-2xl">
                    <h3 class="text-lg font-bold text-white">¿Eliminar proyecto de la galería?</h3>
                    <p class="text-sm text-neutral-400">Esta acción eliminará el proyecto y todos sus archivos de imágenes subidos a Cloudinary.</p>
                    <div class="flex justify-end gap-3 pt-2">
                        <button id="cancel-delete-proj-btn" class="px-4 py-2 rounded-xl text-xs font-semibold bg-white/5 hover:bg-white/10 text-white transition-colors border border-white/5">
                            Cancelar
                        </button>
                        <button id="confirm-delete-proj-btn" class="px-4 py-2 rounded-xl text-xs font-bold bg-red-600 hover:bg-red-500 text-white shadow-lg shadow-red-500/25 transition-colors">
                            Eliminar
                        </button>
                    </div>
                </div>
            </div>

            <!-- Toast de Éxito -->
            <div id="toast-success" class="fixed bottom-6 right-6 transform translate-y-12 opacity-0 pointer-events-none bg-emerald-500 text-white px-4 py-3 rounded-xl shadow-xl flex items-center gap-2 transition-all duration-300 z-50">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span class="text-xs font-bold" id="toast-message">Cambios guardados con éxito</span>
            </div>
        ) : (
            <LoginForm />
        )}
    </main>

    <script>
        import { $$, $ } from "@/consts/dom-selector";

        function showToast(message: string) {
            const toast = document.getElementById('toast-success');
            const toastMsg = document.getElementById('toast-message');
            if (!toast || !toastMsg) return;

            toastMsg.textContent = message;
            toast.classList.remove('translate-y-12', 'opacity-0', 'pointer-events-none');
            toast.classList.add('translate-y-0', 'opacity-100');

            setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('translate-y-12', 'opacity-0', 'pointer-events-none');
            }, 3000);
        }

        function initDeleteProject() {
            const deleteButtons = $$('.delete-proj-btn');
            const modal = document.getElementById('delete-proj-modal');
            const confirmBtn = document.getElementById('confirm-delete-proj-btn');
            const cancelBtn = document.getElementById('cancel-delete-proj-btn');

            let activeIdToDelete: number | null = null;

            deleteButtons.forEach((btn: any) => {
                btn.addEventListener('click', () => {
                    activeIdToDelete = Number(btn.getAttribute('data-id'));
                    if (modal) {
                        modal.classList.remove('hidden');
                        setTimeout(() => modal.classList.add('opacity-100'), 10);
                    }
                });
            });

            const closeModal = () => {
                if (modal) {
                    modal.classList.remove('opacity-100');
                    setTimeout(() => modal.classList.add('hidden'), 300);
                }
                activeIdToDelete = null;
            };

            cancelBtn?.addEventListener('click', closeModal);

            confirmBtn?.addEventListener('click', async () => {
                if (activeIdToDelete === null) return;

                try {
                    const formData = new FormData();
                    formData.append("id", activeIdToDelete.toString());

                    const res = await fetch(`/api/customers/delete`, {
                        method: 'POST',
                        body: formData
                    });

                    // Desvanecer y remover del DOM
                    const item = document.querySelector(`.proj-item[data-id="${activeIdToDelete}"]`);
                    if (item) {
                        item.classList.add('scale-95', 'opacity-0');
                        setTimeout(() => item.remove(), 200);
                    }
                    closeModal();
                    showToast('Proyecto eliminado de la galería');
                } catch (e) {
                    console.error('Error deleting project:', e);
                    closeModal();
                }
            });
        }

        document.addEventListener('DOMContentLoaded', initDeleteProject);
        document.addEventListener('astro:page-load', initDeleteProject);
    </script>
</Layout>

---
import Layout from "@/layouts/AdminLayout.astro";
import LoginForm from "@/components/admin/LoginForm.astro";
import { db } from "@/db/client";
import { PageSections } from "@/db/schema";
import { eq, asc } from "drizzle-orm";
import { ensureDefaultSections } from "@/utils/sections";

const cookie = Astro.cookies.get("admin_session");
const isAuthenticated = cookie?.value === "authenticated";

let faqs: any[] = [];
if (isAuthenticated) {
    await ensureDefaultSections();
    faqs = await db.select()
        .from(PageSections)
        .where(eq(PageSections.type, "faq"))
        .orderBy(asc(PageSections.order));
}
---

<Layout
    description="Gestión de Preguntas Frecuentes - Toldo Perfil"
    title="Gestionar FAQs - Toldo Perfil"
    canonical="https://toldoperfil.es"
>
    <main class="font-sans min-h-screen">
        {isAuthenticated ? (
            <div class="fixed inset-0 -z-10 bg-neutral-900">
                <div class="absolute inset-0 bg-[url('/img/carousel/protrait02.webp')] bg-cover bg-center opacity-20 blur-sm scale-105"></div>
                <div class="absolute inset-0 bg-neutral-900/80 mix-blend-multiply"></div>
            </div>

            <div class="text-white p-6 max-w-5xl mx-auto space-y-8">
                <!-- Header -->
                <header class="flex flex-col md:flex-row justify-between items-center gap-4 bg-white/10 backdrop-blur-xl border border-white/10 rounded-2xl shadow-2xl px-6 py-4">
                    <div class="flex items-center gap-4">
                        <a href="/admin/sections" class="p-2 bg-white/5 hover:bg-white/10 rounded-lg transition-colors border border-white/10">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-indigo-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                            </svg>
                        </a>
                        <div>
                            <h1 class="text-xl font-bold tracking-tight">Preguntas Frecuentes (FAQs)</h1>
                            <p class="text-xs text-indigo-200">Gestiona las dudas habituales de los clientes</p>
                        </div>
                    </div>
                    <div>
                        <a 
                            href="/admin/sections/faqs/create" 
                            class="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 hover:-translate-y-0.5 active:translate-y-0 text-white rounded-xl text-xs font-bold shadow-lg shadow-indigo-500/20 transition-all flex items-center gap-2"
                        >
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                            </svg>
                            Añadir FAQ
                        </a>
                    </div>
                </header>

                <div class="bg-indigo-950/40 border border-indigo-500/10 rounded-2xl p-4 flex gap-3 items-start">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-indigo-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <p class="text-xs text-indigo-200 leading-relaxed">
                        Arrastra las preguntas frecuentes para reordenarlas en el listado público.
                    </p>
                </div>

                <!-- Lista de FAQs con DnD -->
                <div class="bg-neutral-900/60 backdrop-blur-md border border-white/10 rounded-2xl overflow-hidden shadow-xl p-4">
                    {faqs.length === 0 ? (
                        <div class="text-center py-12 text-neutral-400 text-sm">
                            No hay preguntas frecuentes configuradas. Pulsa "Añadir FAQ" para crear una.
                        </div>
                    ) : (
                        <ul id="faqs-list" class="space-y-3">
                            {faqs.map((faq) => {
                                const data = faq.data as any;
                                return (
                                    <li 
                                        data-id={faq.id}
                                        draggable="true" 
                                        class="faq-item-row flex flex-col sm:flex-row sm:items-center justify-between p-4 gap-4 bg-white/5 border border-white/5 rounded-xl hover:border-white/10 hover:bg-white/10 transition-all duration-200 group cursor-grab active:cursor-grabbing"
                                    >
                                        <div class="flex items-center gap-4 min-w-0 w-full sm:w-auto">
                                            <!-- Drag Handle -->
                                            <div class="text-neutral-500 group-hover:text-indigo-400 transition-colors select-none font-mono text-lg shrink-0">
                                                ⣿
                                            </div>
                                            <!-- Info -->
                                            <div class="min-w-0 flex-1">
                                                <h3 class="font-bold text-white text-sm line-clamp-1">{data.question || "Sin pregunta"}</h3>
                                                <p class="text-xs text-neutral-400 line-clamp-1 mt-0.5">{data.answer || "Sin respuesta"}</p>
                                            </div>
                                        </div>

                                        <div class="flex items-center justify-between sm:justify-end gap-3 w-full sm:w-auto border-t border-white/5 sm:border-t-0 pt-3 sm:pt-0 shrink-0">
                                            <!-- Toggle Eye Button -->
                                            <label 
                                                class="relative inline-flex items-center justify-center p-2 rounded-lg border transition-all cursor-pointer select-none text-xs font-semibold gap-1.5 flex-1 sm:flex-initial"
                                                class:list={[
                                                    faq.isEnabled 
                                                        ? "bg-emerald-600/10 hover:bg-emerald-600/20 text-emerald-400 border-emerald-500/20 hover:scale-105 active:scale-95" 
                                                        : "bg-red-600/10 hover:bg-red-600/20 text-red-400 border-red-500/20 hover:scale-105 active:scale-95"
                                                ]}
                                                title={faq.isEnabled ? "Visible (Click para ocultar)" : "Oculto (Click para mostrar)"}
                                            >
                                                <input 
                                                    type="checkbox" 
                                                    class="sr-only toggle-faq-state" 
                                                    data-id={faq.id}
                                                    checked={faq.isEnabled}
                                                />
                                                <!-- Eye open -->
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 eye-open-icon" class:list={[{ "hidden": !faq.isEnabled }]} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                                </svg>
                                                <!-- Eye off -->
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 eye-closed-icon" class:list={[{ "hidden": faq.isEnabled }]} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
                                                </svg>
                                                <span class="status-label">{faq.isEnabled ? "Visible" : "Oculto"}</span>
                                            </label>

                                            <!-- Edit button -->
                                            <a 
                                                href={`/admin/sections/faqs/edit/${faq.id}`} 
                                                class="p-2 bg-indigo-600/20 hover:bg-indigo-600/40 text-indigo-300 hover:text-white rounded-lg border border-indigo-500/20 transition-all text-xs font-semibold flex items-center justify-center gap-1.5 flex-1 sm:flex-initial"
                                            >
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                                </svg>
                                                <span>Editar</span>
                                            </a>

                                            <!-- Delete button -->
                                            <button 
                                                data-id={faq.id}
                                                class="p-2 bg-red-600/10 hover:bg-red-600/30 text-red-400 hover:text-red-200 rounded-lg border border-red-500/20 transition-all delete-faq-btn"
                                            >
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                </svg>
                                            </button>
                                        </div>
                                    </li>
                                );
                            })}
                        </ul>
                    )}
                </div>
            </div>

            <!-- Toast -->
            <div id="toast-success" class="fixed bottom-6 right-6 transform translate-y-12 opacity-0 pointer-events-none bg-emerald-500 text-white px-4 py-3 rounded-xl shadow-xl flex items-center gap-2 transition-all duration-300 z-50">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span class="text-xs font-bold" id="toast-message">Cambios guardados con éxito</span>
            </div>

            <!-- Modal de Confirmación -->
            <div id="delete-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm hidden opacity-0 transition-opacity duration-300">
                <div class="bg-neutral-900 border border-white/10 rounded-2xl max-w-md w-full p-6 space-y-4 shadow-2xl">
                    <h3 class="text-lg font-bold text-white">¿Eliminar pregunta frecuente?</h3>
                    <p class="text-sm text-neutral-400">Esta acción no se puede deshacer. Se eliminarán permanentemente la pregunta y su respuesta correspondiente.</p>
                    <div class="flex justify-end gap-3 pt-2">
                        <button id="cancel-delete-btn" class="px-4 py-2 rounded-xl text-xs font-semibold bg-white/5 hover:bg-white/10 text-white transition-colors border border-white/5">
                            Cancelar
                        </button>
                        <button id="confirm-delete-btn" class="px-4 py-2 rounded-xl text-xs font-bold bg-red-600 hover:bg-red-500 text-white shadow-lg shadow-red-500/25 transition-colors">
                            Eliminar
                        </button>
                    </div>
                </div>
            </div>

            <script>
                import { $$, $ } from "@/consts/dom-selector";

                function showToast(message: string) {
                    const toast = document.getElementById('toast-success');
                    const toastMsg = document.getElementById('toast-message');
                    if (!toast || !toastMsg) return;

                    toastMsg.textContent = message;
                    toast.classList.remove('translate-y-12', 'opacity-0', 'pointer-events-none');
                    toast.classList.add('translate-y-0', 'opacity-100');

                    setTimeout(() => {
                        toast.classList.remove('translate-y-0', 'opacity-100');
                        toast.classList.add('translate-y-12', 'opacity-0', 'pointer-events-none');
                    }, 3000);
                }

                function initDragAndDrop() {
                    const list = document.getElementById('faqs-list');
                    if (!list) return;

                    let dragEl: HTMLElement | null = null;

                    list.addEventListener('dragstart', (e: any) => {
                        dragEl = e.target.closest('.faq-item-row');
                        if (dragEl) {
                            dragEl.classList.add('opacity-55');
                            e.dataTransfer.effectAllowed = 'move';
                        }
                    });

                    list.addEventListener('dragover', (e: any) => {
                        e.preventDefault();
                        const target = e.target.closest('.faq-item-row');
                        if (target && target !== dragEl && dragEl) {
                            const bounding = target.getBoundingClientRect();
                            const offset = e.clientY - bounding.top - (bounding.height / 2);
                            if (offset > 0) {
                                target.after(dragEl);
                            } else {
                                target.before(dragEl);
                            }
                        }
                    });

                    list.addEventListener('dragend', async () => {
                        if (dragEl) {
                            dragEl.classList.remove('opacity-55');
                        }

                        const items = list.querySelectorAll('.faq-item-row');
                        const ids = Array.from(items).map((item: any) => Number(item.getAttribute('data-id')));

                        try {
                            const res = await fetch('/api/sections/reorder', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ ids })
                            });
                            const result = await res.json();
                            if (result.success) {
                                showToast('Orden de FAQs actualizado');
                            }
                        } catch (e) {
                            console.error('Error en fetch FAQs reorder:', e);
                        }
                    });
                }

                function initToggles() {
                    const toggles = $$('.toggle-faq-state');
                    toggles.forEach((checkbox: any) => {
                        checkbox.addEventListener('change', async () => {
                            const id = Number(checkbox.getAttribute('data-id'));
                            const isEnabled = checkbox.checked;
                            const label = checkbox.closest('label');
                            const statusLabel = label?.querySelector('.status-label');
                            const eyeOpen = label?.querySelector('.eye-open-icon');
                            const eyeClosed = label?.querySelector('.eye-closed-icon');

                            const updateVisuals = (active: boolean) => {
                                if (label) {
                                    if (active) {
                                        label.className = "relative inline-flex items-center justify-center p-2 rounded-lg border transition-all cursor-pointer select-none text-xs font-semibold gap-1.5 flex-1 sm:flex-initial bg-emerald-600/10 hover:bg-emerald-600/20 text-emerald-400 border-emerald-500/20 hover:scale-105 active:scale-95";
                                        label.setAttribute('title', 'Visible (Click para ocultar)');
                                        if (statusLabel) statusLabel.textContent = "Visible";
                                        eyeOpen?.classList.remove('hidden');
                                        eyeClosed?.classList.add('hidden');
                                    } else {
                                        label.className = "relative inline-flex items-center justify-center p-2 rounded-lg border transition-all cursor-pointer select-none text-xs font-semibold gap-1.5 flex-1 sm:flex-initial bg-red-600/10 hover:bg-red-600/20 text-red-400 border-red-500/20 hover:scale-105 active:scale-95";
                                        label.setAttribute('title', 'Oculto (Click para mostrar)');
                                        if (statusLabel) statusLabel.textContent = "Oculto";
                                        eyeOpen?.classList.add('hidden');
                                        eyeClosed?.classList.remove('hidden');
                                    }
                                }
                            };

                            updateVisuals(isEnabled);

                            try {
                                const res = await fetch('/api/sections/toggle', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({ id, isEnabled })
                                });
                                const result = await res.json();
                                if (result.success) {
                                    showToast(isEnabled ? 'FAQ activada' : 'FAQ desactivada');
                                } else {
                                    checkbox.checked = !isEnabled;
                                    updateVisuals(!isEnabled);
                                }
                            } catch (e) {
                                checkbox.checked = !isEnabled;
                                updateVisuals(!isEnabled);
                                console.error('Error en fetch FAQ toggle:', e);
                            }
                        });
                    });
                }

                function initDelete() {
                    const deleteButtons = $$('.delete-faq-btn');
                    const modal = document.getElementById('delete-modal');
                    const confirmBtn = document.getElementById('confirm-delete-btn');
                    const cancelBtn = document.getElementById('cancel-delete-btn');

                    let activeIdToDelete: number | null = null;

                    deleteButtons.forEach((btn: any) => {
                        btn.addEventListener('click', () => {
                            activeIdToDelete = Number(btn.getAttribute('data-id'));
                            if (modal) {
                                modal.classList.remove('hidden');
                                setTimeout(() => modal.classList.add('opacity-100'), 10);
                            }
                        });
                    });

                    const closeModal = () => {
                        if (modal) {
                            modal.classList.remove('opacity-100');
                            setTimeout(() => modal.classList.add('hidden'), 300);
                        }
                        activeIdToDelete = null;
                    };

                    cancelBtn?.addEventListener('click', closeModal);
                    
                    confirmBtn?.addEventListener('click', async () => {
                        if (activeIdToDelete === null) return;
                        
                        try {
                            const res = await fetch(`/api/sections/delete`, {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ id: activeIdToDelete })
                            });
                            const result = await res.json();
                            if (result.success) {
                                const itemToRemove = document.querySelector(`.faq-item-row[data-id="${activeIdToDelete}"]`);
                                itemToRemove?.remove();
                                closeModal();
                                showToast('Pregunta frecuente eliminada');
                            }
                        } catch (e) {
                            console.error('Error deleting FAQ:', e);
                            closeModal();
                        }
                    });
                }

                document.addEventListener('DOMContentLoaded', () => {
                    initDragAndDrop();
                    initToggles();
                    initDelete();
                });
                document.addEventListener('astro:page-load', () => {
                    initDragAndDrop();
                    initToggles();
                    initDelete();
                });
            </script>
        ) : (
            <LoginForm />
        )}
    </main>

    <script>
        import { $$, $ } from "@/consts/dom-selector";

        function showToast(message: string) {
            const toast = document.getElementById('toast-success');
            const toastMsg = document.getElementById('toast-message');
            if (!toast || !toastMsg) return;

            toastMsg.textContent = message;
            toast.classList.remove('translate-y-12', 'opacity-0', 'pointer-events-none');
            toast.classList.add('translate-y-0', 'opacity-100');

            setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('translate-y-12', 'opacity-0', 'pointer-events-none');
            }, 3000);
        }

        function initDragAndDrop() {
            const list = document.getElementById('faqs-list');
            if (!list) return;

            let dragEl: HTMLElement | null = null;

            list.addEventListener('dragstart', (e: any) => {
                dragEl = e.target.closest('.faq-item-row');
                if (dragEl) {
                    dragEl.classList.add('opacity-55');
                    e.dataTransfer.effectAllowed = 'move';
                }
            });

            list.addEventListener('dragover', (e: any) => {
                e.preventDefault();
                const target = e.target.closest('.faq-item-row');
                if (target && target !== dragEl && dragEl) {
                    const bounding = target.getBoundingClientRect();
                    const offset = e.clientY - bounding.top - (bounding.height / 2);
                    if (offset > 0) {
                        target.after(dragEl);
                    } else {
                        target.before(dragEl);
                    }
                }
            });

            list.addEventListener('dragend', async () => {
                if (dragEl) {
                    dragEl.classList.remove('opacity-55');
                }

                const items = list.querySelectorAll('.faq-item-row');
                const ids = Array.from(items).map((item: any) => Number(item.getAttribute('data-id')));

                try {
                    const res = await fetch('/api/sections/reorder', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ ids })
                    });
                    const result = await res.json();
                    if (result.success) {
                        showToast('Orden de FAQs actualizado');
                    }
                } catch (e) {
                    console.error('Error en fetch FAQs reorder:', e);
                }
            });
        }

        function initToggles() {
            const toggles = $$('.toggle-faq-state');
            toggles.forEach((checkbox: any) => {
                checkbox.addEventListener('change', async () => {
                    const id = Number(checkbox.getAttribute('data-id'));
                    const isEnabled = checkbox.checked;

                    try {
                        const res = await fetch('/api/sections/toggle', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ id, isEnabled })
                        });
                        const result = await res.json();
                        if (result.success) {
                            showToast(isEnabled ? 'FAQ activada' : 'FAQ desactivada');
                        } else {
                            checkbox.checked = !isEnabled;
                        }
                    } catch (e) {
                        checkbox.checked = !isEnabled;
                        console.error('Error en fetch FAQ toggle:', e);
                    }
                });
            });
        }

        function initDelete() {
            const deleteButtons = $$('.delete-faq-btn');
            const modal = document.getElementById('delete-modal');
            const confirmBtn = document.getElementById('confirm-delete-btn');
            const cancelBtn = document.getElementById('cancel-delete-btn');

            let activeIdToDelete: number | null = null;

            deleteButtons.forEach((btn: any) => {
                btn.addEventListener('click', () => {
                    activeIdToDelete = Number(btn.getAttribute('data-id'));
                    if (modal) {
                        modal.classList.remove('hidden');
                        setTimeout(() => modal.classList.add('opacity-100'), 10);
                    }
                });
            });

            const closeModal = () => {
                if (modal) {
                    modal.classList.remove('opacity-100');
                    setTimeout(() => modal.classList.add('hidden'), 300);
                }
                activeIdToDelete = null;
            };

            cancelBtn?.addEventListener('click', closeModal);
            
            confirmBtn?.addEventListener('click', async () => {
                if (activeIdToDelete === null) return;
                
                try {
                    const res = await fetch(`/api/sections/delete`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ id: activeIdToDelete })
                    });
                    const result = await res.json();
                    if (result.success) {
                        const itemToRemove = document.querySelector(`.faq-item-row[data-id="${activeIdToDelete}"]`);
                        itemToRemove?.remove();
                        closeModal();
                        showToast('Pregunta frecuente eliminada');
                    }
                } catch (e) {
                    console.error('Error deleting FAQ:', e);
                    closeModal();
                }
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            initDragAndDrop();
            initToggles();
            initDelete();
        });
        document.addEventListener('astro:page-load', () => {
            initDragAndDrop();
            initToggles();
            initDelete();
        });
    </script>
</Layout>

---
export const prerender = true;

import Layout from "@/layouts/Layout.astro";
import { LOCATIONS_DATA, type LocationData } from "@/consts/locations";

export async function getStaticPaths() {
    return LOCATIONS_DATA.map((municipio) => {
        // Generates toldos-loeches, toldos-madrid, etc.
        const paramValue = municipio.slug.replace("toldos-", "");
        return {
            params: { municipio: paramValue },
            props: { municipio },
        };
    });
}

interface Props {
    municipio: LocationData;
}

const { municipio } = Astro.props;

// Dynamic Meta tags with transactional calls
const metaTitle = `Instalación de Toldos en ${municipio.municipioName} | Precio de Fábrica`;
const metaDescription = `${municipio.descriptionLocal} Fabricamos e instalamos toldos cofres, toldos brazo extensible y pérgolas bioclimáticas. ¡Presupuesto gratis hoy!`;
const canonicalUrl = `https://toldoperfil.es/toldos-${municipio.slug.replace("toldos-", "")}`;

// Prevent thin content by tailoring based on geographical zone
const isPriorityZone1 = municipio.priorityZone === 1;
const zoneBadgeText = isPriorityZone1 ? "Zona de Servicio Preferente (Cercanía Extrema)" : "Servicio Oficial Comunidad de Madrid";
---

<Layout 
    title={metaTitle} 
    description={metaDescription}
    canonical={canonicalUrl}
>
    <!-- Structured Data JSON-LD LocalBusiness + AreaServed -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": "Toldo Perfil",
        "image": "https://toldoperfil.es/img/og.jpeg",
        "@id": `https://toldoperfil.es/toldos-${municipio.slug.replace("toldos-", "")}#localbusiness`,
        "url": `https://toldoperfil.es/toldos-${municipio.slug.replace("toldos-", "")}`,
        "telephone": "+34639535038",
        "priceRange": "$$",
        "address": {
            "@type": "PostalAddress",
            "streetAddress": "Sector M-4, Nave 37",
            "addressLocality": "Velilla de San Antonio",
            "postalCode": "28891",
            "addressRegion": "Madrid",
            "addressCountry": "ES"
        },
        "geo": {
            "@type": "GeoCoordinates",
            "latitude": 40.3541,
            "longitude": -3.4883
        },
        "openingHoursSpecification": {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": [
                "Monday",
                "Tuesday",
                "Wednesday",
                "Thursday",
                "Friday"
            ],
            "opens": "09:00",
            "closes": "19:00"
        },
        "areaServed": [
            {
                "@type": "AdministrativeArea",
                "name": municipio.municipioName
            },
            {
                "@type": "AdministrativeArea",
                "name": "Velilla de San Antonio"
            },
            {
                "@type": "AdministrativeArea",
                "name": "Comunidad de Madrid"
            }
        ]
    })} />

    <main class="min-h-screen bg-slate-900 text-white selection:bg-indigo-500 py-12">
        <div class="max-w-4xl mx-auto px-6 space-y-12">
            
            <!-- Breadcrumbs -->
            <nav class="text-xs text-slate-400 flex items-center gap-2">
                <a href="/" class="hover:text-indigo-400 transition-colors">Inicio</a>
                <span>/</span>
                <span class="text-slate-200">Instalación en {municipio.municipioName}</span>
            </nav>

            <!-- Hero Section / Header Block -->
            <header class="relative bg-gradient-to-br from-indigo-950/80 to-slate-900 border border-indigo-500/20 rounded-3xl p-8 sm:p-12 overflow-hidden shadow-2xl">
                <div class="absolute -right-24 -top-24 w-64 h-64 bg-indigo-600/10 rounded-full blur-3xl"></div>
                
                <span class={`inline-block px-3 py-1 text-xs font-bold rounded-full mb-6 border ${
                    isPriorityZone1 
                    ? "bg-emerald-500/10 text-emerald-400 border-emerald-500/20" 
                    : "bg-indigo-500/10 text-indigo-400 border-indigo-500/20"
                }`}>
                    {zoneBadgeText}
                </span>

                <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white leading-tight">
                    Toldos y Pérgolas en <span class="text-indigo-400">{municipio.municipioName}</span>
                </h1>
                
                <p class="text-slate-300 text-base sm:text-lg mt-6 leading-relaxed max-w-2xl">
                    {municipio.descriptionLocal} Garantizamos una instalación impecable adaptada al clima de la zona con materiales de primera calidad fabricados en España.
                </p>

                <!-- Action Button -->
                <div class="mt-8 flex flex-wrap gap-4">
                    <a 
                        href="/#contacto" 
                        class="px-6 py-3.5 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold rounded-xl transition-all shadow-lg shadow-indigo-600/30 text-sm"
                    >
                        Solicitar Presupuesto Gratis
                    </a>
                </div>
            </header>

            <!-- Geographical Priority Hook (Anti-thin content) -->
            <section class="space-y-6">
                <h2 class="text-2xl font-bold text-slate-100 flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    Compromiso de Servicio Técnico y Cercanía
                </h2>

                {isPriorityZone1 ? (
                    <!-- Priority 1 Content Block -->
                    <div class="bg-emerald-500/5 border border-emerald-500/20 rounded-2xl p-6 space-y-4">
                        <div class="flex items-center gap-3">
                            <span class="p-2 bg-emerald-500/10 text-emerald-400 rounded-lg">🚀</span>
                            <h3 class="text-lg font-bold text-white">Instalador Directo con Cobertura Inmediata</h3>
                        </div>
                        <p class="text-slate-300 text-sm leading-relaxed">
                            Al encontrarse {municipio.municipioName} en nuestra zona de prioridad de servicio a escasos minutos de nuestro centro operativo en Velilla de San Antonio, podemos ofrecerte un servicio de medición en domicilio rápido e instalación exprés preferente. No pagues intermediarios ni costes excesivos de desplazamiento.
                        </p>
                    </div>
                ) : (
                    <!-- Priority 2 Content Block -->
                    <div class="bg-indigo-500/5 border border-indigo-500/20 rounded-2xl p-6 space-y-4">
                        <div class="flex items-center gap-3">
                            <span class="p-2 bg-indigo-500/10 text-indigo-400 rounded-lg">🛡️</span>
                            <h3 class="text-lg font-bold text-white">Servicio de Instalación Autorizado</h3>
                        </div>
                        <p class="text-slate-300 text-sm leading-relaxed">
                            Ofrecemos soporte integral en toda la Comunidad de Madrid. Contamos con equipos de instaladores dedicados y talleres móviles listos para desplazarse a {municipio.municipioName} para realizar mediciones exactas con láser digital, asesorarte estéticamente y realizar montajes limpios y duraderos.
                        </p>
                    </div>
                )}
            </section>

            <!-- Value Proposition Checklist -->
            <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
                {municipio.puntosFuertes.map((punto, index) => (
                    <div class="bg-slate-800/40 border border-slate-700/50 rounded-2xl p-6 flex flex-col justify-between hover:border-indigo-500/30 transition-all">
                        <div class="text-indigo-400 text-lg font-black mb-4">0{index + 1}</div>
                        <p class="text-sm text-slate-200 font-medium leading-relaxed">{punto}</p>
                    </div>
                ))}
            </section>

            <!-- Local Keywords / Solutions Showcase -->
            <section class="space-y-6">
                <h2 class="text-2xl font-bold text-slate-100">
                    Sistemas de Protección Solar que Instalamos
                </h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    {municipio.keywords.map((kw) => (
                        <div class="flex items-center gap-3 bg-slate-800/65 border border-slate-700/50 rounded-xl p-4 hover:bg-slate-800 transition-colors">
                            <span class="w-3 h-3 rounded-full bg-indigo-500"></span>
                            <span class="text-sm font-semibold capitalize text-slate-200">{kw} en {municipio.municipioName}</span>
                        </div>
                    ))}
                </div>
            </section>

            <!-- Local SEO Footer Notice -->
            <footer class="border-t border-slate-800 pt-8 text-center text-xs text-slate-500 leading-relaxed">
                Toldo Perfil &copy; {new Date().getFullYear()} - Fábrica central en Velilla de San Antonio. Especialistas homologados en protección solar y automatismos domóticos. Instalación oficial de toldos en {municipio.municipioName}.
            </footer>
        </div>
    </main>
</Layout>

---
export const prerender = true;
import Layout from "@/layouts/Layout.astro";

export async function getStaticPaths() {
    const posts = Object.values(import.meta.glob('../../blog-posts/*.md', { eager: true })) as any[];
    return posts.map(post => {
        const slug = post.file.split('/').pop().replace('.md', '');
        return {
            params: { slug },
            props: { post }
        };
    });
}

const { post } = Astro.props;
const { Content, frontmatter } = post;
const { title, description, date } = frontmatter;

const formattedDate = new Date(date).toLocaleDateString('es-ES', {
    day: '2-digit',
    month: 'long',
    year: 'numeric'
});
const { slug } = Astro.params;

const schema = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": title,
    "description": description,
    "datePublished": date,
    "dateModified": date,
    "author": {
        "@type": "Organization",
        "name": "Toldo Perfil",
        "url": "https://toldoperfil.es"
    },
    "publisher": {
        "@type": "Organization",
        "name": "Toldo Perfil",
        "logo": {
            "@type": "ImageObject",
            "url": "https://toldoperfil.es/img/logo.png"
        }
    },
    "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": `https://toldoperfil.es/blog/${slug}`
    }
};
---

<Layout
    description={description}
    title={`${title} | Blog Toldo Perfil`}
    canonical={`https://toldoperfil.es/blog/${slug}`}
    isVisibleNav={true}
>
    <!-- Inject JSON-LD Schema Markup -->
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <main class="max-w-3xl mx-auto px-6 py-16 text-gray-800">
        <!-- Back navigation link -->
        <div class="mb-8">
            <a 
                href="/blog" 
                class="inline-flex items-center text-sm font-semibold text-indigo-900 hover:text-indigo-700 gap-1 transition-colors"
                aria-label="Volver al índice del blog"
            >
                ← Volver al blog
            </a>
        </div>

        <article class="bg-white border border-indigo-900/10 rounded-3xl p-8 md:p-12 shadow-sm">
            <header class="mb-8 border-b border-indigo-950/10 pb-6">
                <span class="text-xs font-semibold text-indigo-600 tracking-wider uppercase">{formattedDate}</span>
                <h1 class="text-3xl md:text-4xl font-extrabold text-indigo-950 mt-3 mb-4 leading-tight tracking-tight">
                    {title}
                </h1>
                <p class="text-base text-gray-500 font-light leading-relaxed">
                    {description}
                </p>
            </header>

            <!-- Markdown content parser wrapper -->
            <div class="blog-markdown-content leading-relaxed text-gray-700 font-light space-y-6">
                <Content />
            </div>

            <!-- Footer CTA within the article card -->
            <footer class="mt-12 pt-8 border-t border-indigo-950/10 flex flex-col items-center text-center">
                <h3 class="text-lg font-bold text-indigo-950 mb-2">¿Necesitas climatizar tu espacio exterior?</h3>
                <p class="text-sm text-gray-500 max-w-md mb-6 leading-normal font-light">
                    Fabricamos e instalamos toldos y pérgolas a medida. Solicita presupuesto directo por WhatsApp para recibir asesoramiento personalizado.
                </p>
                <a 
                    id="blogWhatsappCta"
                    href={`https://wa.me/34628404370?text=Hola,%20he%20leído%20el%20artículo%20"${encodeURIComponent(title)}"%20en%20el%20blog%20y%20me%20gustaría%20solicitar%20un%20presupuesto.`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-6 py-3 bg-emerald-600 text-white font-bold rounded-lg shadow-lg hover:bg-emerald-500 hover:shadow-emerald-500/20 transition-all duration-200 hover:-translate-y-0.5 uppercase text-xs tracking-wider flex items-center gap-2"
                    aria-label="Pedir presupuesto de toldo por WhatsApp"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.894-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
                    </svg>
                    Pedir Presupuesto WhatsApp
                </a>
            </footer>
        </article>
    </main>

    <script>
        const btn = document.getElementById("blogWhatsappCta");
        if (btn) {
            btn.addEventListener("click", async () => {
                try {
                    await fetch("/api/analytics/track", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            type: "whatsapp_click",
                            data: {
                                path: window.location.pathname,
                                source: "blog_detail_footer"
                            }
                        })
                    });
                } catch (e) {
                    console.error("Analytics Error", e);
                }
            });
        }
    </script>
</Layout>

<style is:global>
    /* Styling classes for the compiled Markdown elements inside the blog detail */
    .blog-markdown-content h1 {
        @apply text-2xl md:text-3xl font-extrabold text-indigo-950 mt-8 mb-4 border-b border-indigo-950/5 pb-2;
    }
    .blog-markdown-content h2 {
        @apply text-xl md:text-2xl font-bold text-indigo-950 mt-8 mb-4;
    }
    .blog-markdown-content h3 {
        @apply text-lg font-semibold text-indigo-950 mt-6 mb-3;
    }
    .blog-markdown-content p {
        @apply text-sm sm:text-base leading-relaxed text-gray-600 text-justify mb-4;
    }
    .blog-markdown-content ul {
        @apply list-disc pl-6 space-y-2 mb-6 text-sm sm:text-base text-gray-600;
    }
    .blog-markdown-content ol {
        @apply list-decimal pl-6 space-y-2 mb-6 text-sm sm:text-base text-gray-600;
    }
    .blog-markdown-content li strong {
        @apply font-semibold text-indigo-950;
    }
    .blog-markdown-content strong {
        @apply font-bold text-indigo-950;
    }
    .blog-markdown-content hr {
        @apply my-8 border-t border-indigo-950/10;
    }
    .blog-markdown-content blockquote {
        @apply pl-4 border-l-4 border-indigo-600 italic text-gray-500 my-6;
    }
</style>

export const prerender = true;
import Layout from "@/layouts/Layout.astro";
import { db } from "@/db/client";
import { Blogs } from "@/db/schema";
import { desc, and, eq, lte } from "drizzle-orm";
import { isBlogEnabled } from "@/utils/settings";

// Este check se evalúa UNA VEZ durante el build, no en cada request.
const blogEnabled = await isBlogEnabled();

// Si el blog está desactivado en la build, se genera una redirección estática.
if (!blogEnabled) {
    return Astro.redirect("/");
}

let posts = [];
try {
    const now = new Date();
    posts = await db.select()
        .from(Blogs)
        .where(
            and(
                eq(Blogs.isVisible, true),
                lte(Blogs.publishedAt, now)
            )
        )
        .orderBy(desc(Blogs.publishedAt));
} catch (e) {
    console.log("No blog posts found yet.", e);
}

const schema = {
    "@context": "https://schema.org",
    "@type": "Blog",
    "name": "Blog de Toldos y Climatización Exterior | Toldo Perfil",
    "description": "Consejos de climatización, guías de mantenimiento de toldos y últimas tendencias en pérgolas y protección solar en Velilla de San Antonio, Loeches y Madrid.",
    "publisher": {
        "@type": "Organization",
        "name": "Toldo Perfil",
        "logo": {
            "@type": "ImageObject",
            "url": "https://toldoperfil.es/img/logo.png"
        }
    },
    "url": "https://toldoperfil.es/blog",
    "itemListElement": posts.map((post: any, idx: number) => ({
        "@type": "ListItem",
        "position": idx + 1,
        "url": `https://toldoperfil.es/blog/${post.slug}`
    }))
};
---

<Layout
    description="Consejos de climatización, guías de mantenimiento de toldos y últimas tendencias en pérgolas y protección solar en Velilla de San Antonio, Loeches y Madrid."
    title="Blog de Toldos y Climatización Exterior | Toldo Perfil"
    canonical="https://toldoperfil.es/blog"
    isVisibleNav={true}
>
    <!-- Inject JSON-LD Schema Markup -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    <main class="max-w-5xl mx-auto px-6 py-16 text-gray-800">
        <header class="flex flex-col md:flex-row justify-between items-center gap-6 mb-12 border-b border-indigo-950/10 pb-8">
            <div class="text-center md:text-left">
                <h1 class="text-4xl font-extrabold text-indigo-950 tracking-tight mb-3">Blog de Climatización & Toldos</h1>
                <p class="text-base sm:text-lg text-indigo-900/80 font-light max-w-2xl">
                    Guías de mantenimiento, novedades en automatización y consejos prácticos para optimizar la sombra de tu terraza, jardín o local comercial en Madrid.
                </p>
            </div>
            <div class="w-full md:w-auto flex justify-center">
                <a 
                    id="blogIndexWhatsappCta"
                    href="https://wa.me/34628404370?text=Hola,%20vengo%20del%20blog%20de%20Toldo%20Perfil%20y%20me%20gustaría%20solicitar%20un%20presupuesto."
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-full sm:w-auto px-6 py-3 bg-emerald-600 hover:bg-emerald-500 text-white font-bold rounded-lg shadow-lg hover:shadow-emerald-500/20 transition-all duration-200 hover:-translate-y-0.5 uppercase text-xs tracking-wider flex items-center justify-center gap-2 text-center"
                    aria-label="Pedir presupuesto por WhatsApp"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.894-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
                    </svg>
                    Pedir Presupuesto WhatsApp
                </a>
            </div>
        </header>

        {posts.length > 0 ? (
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                {posts.map(post => {
                    const { title, description, publishedAt, slug } = post;
                    
                    const formattedDate = new Date(publishedAt).toLocaleDateString('es-ES', {
                        day: '2-digit',
                        month: 'long',
                        year: 'numeric'
                    });

                    return (
                        <article class="flex flex-col bg-white border border-indigo-900/10 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow duration-200 justify-between">
                            {post.image && (
                                <a href={`/blog/${slug}`} class="block aspect-video overflow-hidden border-b border-indigo-900/5 bg-neutral-100">
                                    <img 
                                        src={post.image} 
                                        alt={title}
                                        class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                                        loading="lazy"
                                    />
                                </a>
                            )}
                            <div class="p-6 flex-grow flex flex-col justify-between">
                                <div>
                                    <span class="text-xs font-semibold text-indigo-600 tracking-wider uppercase">{formattedDate}</span>
                                    <h2 class="text-xl font-bold text-indigo-950 mt-2 mb-3 leading-snug">
                                        <a href={`/blog/${slug}`} class="hover:text-indigo-700 transition-colors">
                                            {title}
                                        </a>
                                    </h2>
                                    <p class="text-sm font-light text-gray-600 leading-relaxed mb-6">
                                        {description}
                                    </p>
                                </div>
                                <div>
                                    <a 
                                        href={`/blog/${slug}`} 
                                        class="inline-flex items-center text-sm font-bold text-indigo-900 hover:text-indigo-700 gap-1 group"
                                        aria-label={`Leer artículo completo: ${title}`}
                                    >
                                        Leer artículo completo 
                                        <span class="group-hover:translate-x-0.5 transition-transform duration-200">→</span>
                                    </a>
                                </div>
                            </div>
                        </article>
                    );
                })}
            </div>
        ) : (
            <div class="text-center py-16 bg-white/50 border border-dashed border-indigo-900/20 rounded-2xl">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-indigo-900/30 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                </svg>
                <p class="text-sm text-gray-500 font-light">
                    Nuestros redactores e IA están recopilando las últimas tendencias. Próximamente se publicará el primer artículo.
                </p>
            </div>
        )}
    </main>

    <script>
        const btn = document.getElementById("blogIndexWhatsappCta");
        if (btn) {
            btn.addEventListener("click", async () => {
                try {
                    await fetch("/api/analytics/track", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            type: "whatsapp_click",
                            data: {
                                path: window.location.pathname,
                                source: "blog_index_header"
                            }
                        })
                    });
                } catch (e) {
                    console.error("Analytics Error", e);
                }
            });
        }
    </script>
</Layout>

---
export const prerender = true;
import Layout from "@/layouts/Layout.astro";
import Hero from "@/sections/Hero.astro";
import Info from "@/sections/Info.astro";
import BrandsAndFranchises from "@/sections/BrandsAndFranchises.astro";
import Communities from "@/sections/Communities.astro";
import Individuals from "@/sections/PrivateCustomers.astro";
import Products from "@/sections/Products.astro";
import FAQs from "@/sections/FAQs.astro";
import Form from "@/sections/Form.astro";
---

<Layout
	description="Fábrica y montaje de toldos a medida. Diseñamos e instalamos toldos para terrazas, pérgolas bioclimáticas, capotas y cerramientos de aluminio directos de fábrica en la Comunidad de Madrid. ¡Solicita tu presupuesto gratuito!"
	title="Toldo Perfil | Fabricación e Instalación de Toldos y Pérgolas a Medida"
	canonical="https://toldoperfil.es"
	image="/img/og.jpeg"
	isVisibleNav={true}
	preload={[
		{
			as: "image",
			href: "/img/carousel/protrait01.webp",
			type: "image/webp",
			fetchpriority: "high",
		},
	]}
>
	<main class="font-sans">
		<Hero />
		<Info />
		<BrandsAndFranchises />
		<Communities />
		<Individuals />
		<Products />
		<FAQs />
		<Form />
	</main>
</Layout>

---
export const prerender = true;
import Layout from "@/layouts/Layout.astro";
import Hero from "@/sections/Hero.astro";
import Info from "@/sections/Info.astro";
import BrandsAndFranchises from "@/sections/BrandsAndFranchises.astro";
import Communities from "@/sections/Communities.astro";
import Individuals from "@/sections/PrivateCustomers.astro";
import Products from "@/sections/Products.astro";
import FAQs from "@/sections/FAQs.astro";
import Form from "@/sections/Form.astro";
---

<Layout
	description="¿Buscas toldos a medida? Expertos en la creación y montaje de toldos, pérgolas, capotas y cerramientos en Velilla de San Antonio, Loeches y todo Madrid. ¡Presupuesto gratuito!"
	title="Creación y Montaje de Toldos en Velilla de San Antonio, Loeches y Madrid - Toldo Perfil"
	canonical="https://toldoperfil.es"
	image="/img/og-seo.png"
	isVisibleNav={true}
	preload={[
		{
			as: "image",
			href: "/img/carousel/protrait01.webp",
			type: "image/webp",
		},
	]}
>
	<Hero />
	<main class="font-sans">
		<Info />
		<BrandsAndFranchises />
		<Communities />
		<Individuals />
		<Products />
		<FAQs />
		<Form />
	</main>
</Layout>

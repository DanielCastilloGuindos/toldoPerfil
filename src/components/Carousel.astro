            arrowLeft
        </button>
        <button id="arrowRigth" aria-label="Flecha derecha" class="pointer-events-auto cursor-[url(/img/carousel/arrow-right.png),_pointer] text-transparent outline-none">
            arrowRigth
        </button>
    </div>

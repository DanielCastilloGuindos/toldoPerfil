<script>
    function initCarousel() {
        const container = document.getElementById("carousel-container");
        if (!container) return;

        const slides = container.querySelectorAll(".carousel-slide");
        const btnLeft = container.querySelector("#arrowLeft");
        const btnRight = container.querySelector("#arrowRigth");
        
        let currentIndex = 0;
        let intervalId: any = null;
        const intervalTime = 5000;

        function showSlide(index: number) {
            slides.forEach((slide, idx) => {
                if (idx === index) {
                    slide.classList.remove("opacity-0");
                    slide.classList.add("opacity-100", "active");
                    slide.setAttribute("aria-hidden", "false");
                } else {
                    slide.classList.remove("opacity-100", "active");
                    slide.classList.add("opacity-0");
                    slide.setAttribute("aria-hidden", "true");
                }
            });
            currentIndex = index;
        }

        function nextSlide() {
            const nextIdx = (currentIndex + 1) % slides.length;
            showSlide(nextIdx);
        }

        function prevSlide() {
            const prevIdx = (currentIndex - 1 + slides.length) % slides.length;
            showSlide(prevIdx);
        }

        function startTimer() {
            stopTimer();
            intervalId = setInterval(nextSlide, intervalTime);
        }

        function stopTimer() {
            if (intervalId) {
                clearInterval(intervalId);
            }
        }

        btnLeft?.addEventListener("click", (e) => {
            e.preventDefault();
            prevSlide();
            startTimer();
        });

        btnRight?.addEventListener("click", (e) => {
            e.preventDefault();
            nextSlide();
            startTimer();
        });

        // Initialize
        showSlide(0);
        startTimer();
    }

    // Initialize on page load and View Transitions load
    document.addEventListener("astro:page-load", initCarousel);
</script>

<style>
    /* Estado inicial no activo para los elementos de texto en la diapositiva */
    .carousel-slide h1,
    .carousel-slide h2,
    .carousel-slide p,
    .carousel-slide .carousel-btn-wrapper {
        opacity: 0;
        transform: translateY(-30px);
        transition: opacity 800ms cubic-bezier(0.16, 1, 0.3, 1), transform 800ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* Diapositiva activa: Animación de arriba a abajo en cascada */
    .carousel-slide.active h1,
    .carousel-slide.active h2 {
        opacity: 1;
        transform: translateY(0);
        transition-delay: 350ms;
    }

    .carousel-slide.active p {
        opacity: 1;
        transform: translateY(0);
        transition-delay: 550ms;
    }

    .carousel-slide.active .carousel-btn-wrapper {
        opacity: 1;
        transform: translateY(0);
        transition-delay: 750ms;
    }
</style>

        <img class="w-full h-full object-cover aspect-[4:3] sm:aspect-[16/9] min-h-[400px] sm:min-h-[600px]" src="/img/carousel/protrait02.webp" alt="Imagen de Pérgolas y Cerramientos a Medida" loading="lazy" />
        <figcaption class="absolute inset-0 w-full h-full flex flex-col sm:gap-4 justify-center items-center bg-gray-900/50 text-center sm:text-start sm:px-16">

            arrowLeft
        </button>
        <button id="arrowRigth" aria-label="Flecha derecha" class="cursor-[url(/img/carousel/arrow-right.png),_pointer] text-transparent outline-none">
            arrowRigth
        </button>
    </div>
</div>

<script>
    function initCarousel() {
        const container = document.getElementById("carousel-container");
        if (!container) return;

        const slides = container.querySelectorAll(".carousel-slide");
        const btnLeft = container.querySelector("#arrowLeft");
        const btnRight = container.querySelector("#arrowRigth");
        
        let currentIndex = 0;
        let intervalId: any = null;
        const intervalTime = 8000;

        function showSlide(index: number) {
            slides.forEach((slide, idx) => {
                if (idx === index) {
                    slide.classList.remove("opacity-0");
                    slide.classList.add("opacity-100");
                    slide.setAttribute("aria-hidden", "false");
                } else {
                    slide.classList.remove("opacity-100");
                    slide.classList.add("opacity-0");
                    slide.setAttribute("aria-hidden", "true");
                }
            });
            currentIndex = index;
        }

        function nextSlide() {
            const nextIdx = (currentIndex + 1) % slides.length;
            showSlide(nextIdx);
        }

        function prevSlide() {
            const prevIdx = (currentIndex - 1 + slides.length) % slides.length;
            showSlide(prevIdx);
        }

        function startTimer() {
            stopTimer();
            intervalId = setInterval(nextSlide, intervalTime);
        }

        function stopTimer() {
            if (intervalId) {
                clearInterval(intervalId);
            }
        }

        btnLeft?.addEventListener("click", (e) => {
            e.preventDefault();
            prevSlide();
            startTimer();
        });

        btnRight?.addEventListener("click", (e) => {
            e.preventDefault();
            nextSlide();
            startTimer();
        });

        // Initialize
        showSlide(0);
        startTimer();
    }

    // Initialize on page load and View Transitions load
    document.addEventListener("astro:page-load", initCarousel);
</script>

<button
	id="HamburgerButton"
	aria-label="Boton del menu desplegable de la cabecera"
	type="button"
	class="group relative w-10 h-10 block sm:hidden focus:outline-none bg-red-700-button z-10"
	class:list={Astro.props.class}>
		<span class="absolute top-[35%] left-2/4 -translate-x-2/4 translate-y-2/4 block w-6 h-[2.5px] bg-indigo-900 rounded-sm group-[.open]:animate-topbarx"></span>
		<span class="absolute top-2/4 left-2/4 -translate-x-2/4 translate-y-2/4 block w-6 h-[2.5px] bg-indigo-900 rounded-sm group-[.open]:animate-middlebarx"></span>
		<span class="absolute top-[65%] left-2/4 -translate-x-2/4 translate-y-2/4 block w-6 h-[2.5px] bg-indigo-900 rounded-sm group-[.open]:animate-bottombarx"></span>
</button>

<script>
	import { $, $$ } from "@/consts/dom-selector";

	const initMenuToggle = () => {
		const hamburgerButton = $('#HamburgerButton');
		const menu = $('#menu');

		if (hamburgerButton && menu) {
			// Remove any existing event listener to prevent duplicate binding (especially if elements persist)
			const clickHandler = () => {
				hamburgerButton.classList.toggle('open');
				menu.classList.toggle('open');

				const hamburgerButtonClick = new CustomEvent('hamburgerButtonClick');
				hamburgerButton.dispatchEvent(hamburgerButtonClick);
			};
			
			// We can clone and replace, or just toggle class directly.
			// Since we want to ensure only one listener is active on these elements (since Header persists):
			hamburgerButton.onclick = clickHandler;
		}
	};

	document.addEventListener("astro:page-load", initMenuToggle);
</script>
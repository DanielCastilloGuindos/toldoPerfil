---
import { db } from "@/db/client";
import { Customers, Analytics } from "@/db/schema";
import { eq, desc } from "drizzle-orm";
import TrashIcon from "@/icons/admin/trash.astro";

// Fetch data
const customersData = await db
    .select()
    .from(Customers)
    .orderBy(desc(Customers.published));
---

<div
    class="bg-neutral-900/60 backdrop-blur-md border border-white/10 rounded-2xl overflow-hidden shadow-xl"
>
    <!-- Desktop Table View -->
    <div class="hidden md:block overflow-x-auto">
        <table class="w-full text-left text-sm text-indigo-100">
            <thead
                class="bg-white/5 text-xs uppercase text-indigo-300 font-bold tracking-wider"
            >
                <tr>
                    <th class="px-6 py-4">Imagen</th>
                    <th class="px-6 py-4">Título / ID</th>
                    <th class="px-6 py-4">Categoría</th>
                    <th class="px-6 py-4 text-center">Estado</th>
                    <th class="px-6 py-4">Fecha</th>
                    <th class="px-6 py-4 text-right">Acciones</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
                {
                    customersData.map((customer) => (
                        <tr class="hover:bg-white/5 transition-colors group">
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="h-10 w-16 relative rounded overflow-hidden border border-white/10 bg-neutral-800">
                                    <img
                                        src={
                                            ((customer.images as string[]) ||
                                                [])[0] ||
                                            "/img/placeholder.webp"
                                        }
                                        class="w-full h-full object-cover"
                                        loading="lazy"
                                    />
                                    <span class="absolute bottom-0 right-0 bg-black/60 text-[10px] text-white px-1 leading-none rounded-tl">
                                        {
                                            (
                                                (customer.images as string[]) ||
                                                []
                                            ).length
                                        }
                                    </span>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="font-medium text-white">
                                    {customer.title}
                                </div>
                                <div class="text-xs text-indigo-300/50">
                                    ID: {customer.customer_id}
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <span
                                    class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium capitalize ${
                                        customer.category === "enterprise"
                                            ? "bg-indigo-500/10 text-indigo-300 border border-indigo-500/20"
                                            : "bg-purple-500/10 text-purple-300 border border-purple-500/20"
                                    }`}
                                >
                                    {customer.category === "enterprise"
                                        ? "Empresa"
                                        : "Particular"}
                                </span>
                            </td>
                             <td class="px-6 py-4 text-center">
                                {customer.isVisible ? (
                                    <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                                        Publicado
                                    </span>
                                ) : (
                                    <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-neutral-800 text-neutral-400 border border-neutral-700">
                                        Oculto
                                    </span>
                                )}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-indigo-200/50">
                                {new Date(
                                    customer.published,
                                ).toLocaleDateString()}
                            </td>
                            <td class="px-6 py-4 text-right whitespace-nowrap">
                                <div class="flex justify-end items-center gap-2">
                                    <form
                                        action="/api/customers/toggle-visibility"
                                        method="POST"
                                        class="inline-block"
                                    >
                                        <input
                                            type="hidden"
                                            name="id"
                                            value={customer.customer_id}
                                        />
                                        <button
                                            type="button"
                                            class={`confirm-trigger-btn p-2 rounded-lg border transition-colors ${
                                                customer.isVisible
                                                    ? "bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-400 border-emerald-500/20"
                                                    : "bg-neutral-800 hover:bg-neutral-700 text-neutral-400 border-neutral-700"
                                            }`}
                                            title={customer.isVisible ? "Ocultar" : "Mostrar"}
                                            data-title={customer.isVisible ? "Ocultar proyecto" : "Mostrar proyecto"}
                                            data-desc={customer.isVisible ? "¿Estás seguro de que deseas ocultar este proyecto? Ya no aparecerá en la web pública." : "¿Estás seguro de que deseas mostrar este proyecto? Estará visible para todos los visitantes."}
                                            data-btn-color="emerald"
                                        >
                                            {customer.isVisible ? (
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                                </svg>
                                            ) : (
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
                                                </svg>
                                            )}
                                        </button>
                                    </form>
                                    <a
                                        href={`/proyectos/${customer.customer_id}`}
                                        target="_blank"
                                        class="p-2 bg-white/5 hover:bg-white/10 rounded-lg border border-white/10 transition-colors text-white"
                                        title="Ver en vivo"
                                    >
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                                        </svg>
                                    </a>
                                    <a
                                        href={`/admin/edit/${customer.customer_id}`}
                                        class="p-2 bg-indigo-600/20 hover:bg-indigo-600/30 text-indigo-300 rounded-lg border border-indigo-500/20 transition-colors"
                                        title="Editar"
                                    >
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                        </svg>
                                    </a>
                                    <button
                                        data-id={customer.customer_id}
                                        class="delete-btn p-2 bg-red-500/10 hover:bg-red-500/20 text-red-400 rounded-lg border border-red-500/20 transition-colors"
                                        title="Eliminar"
                                        data-title="Eliminar proyecto"
                                        data-desc="¿Estás seguro de que deseas eliminar permanentemente este proyecto del portfolio? Esta acción no se puede deshacer."
                                        data-btn-color="red"
                                    >
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    ))
                }
            </tbody>
        </table>
    </div>

    <!-- Mobile Card View -->
    <div class="block md:hidden divide-y divide-white/5">
        {
            customersData.map((customer) => (
                <div class="p-5 space-y-3">
                    <div class="flex items-center gap-4">
                        <div class="h-10 w-16 relative rounded overflow-hidden border border-white/10 bg-neutral-800 shrink-0">
                            <img
                                src={
                                    ((customer.images as string[]) ||
                                        [])[0] ||
                                    "/img/placeholder.webp"
                                }
                                class="w-full h-full object-cover"
                                loading="lazy"
                            />
                            <span class="absolute bottom-0 right-0 bg-black/60 text-[10px] text-white px-1 leading-none rounded-tl">
                                {
                                    (
                                        (customer.images as string[]) ||
                                        []
                                    ).length
                                }
                            </span>
                        </div>
                        <div class="min-w-0 flex-1">
                            <h4 class="text-white font-medium truncate">
                                {customer.title}
                            </h4>
                            <div class="text-xs text-indigo-300/50">
                                ID: {customer.customer_id}
                            </div>
                        </div>
                    </div>

                    <div class="flex items-center justify-between text-xs pt-1">
                        <span
                            class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-medium capitalize ${
                                customer.category === "enterprise"
                                    ? "bg-indigo-500/10 text-indigo-300 border border-indigo-500/20"
                                    : "bg-purple-500/10 text-purple-300 border border-purple-500/20"
                            }`}
                        >
                            {customer.category === "enterprise"
                                ? "Empresa"
                                : "Particular"}
                        </span>
                        
                        {customer.isVisible ? (
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                                Publicado
                            </span>
                        ) : (
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-neutral-800 text-neutral-400 border border-neutral-700">
                                Oculto
                            </span>
                        )}

                        <span class="text-indigo-200/50">
                            {new Date(customer.published).toLocaleDateString()}
                        </span>
                    </div>

                    <!-- Action Buttons -->
                    <div class="flex justify-end items-center gap-1.5 pt-2 border-t border-white/5">
                        <form
                            action="/api/customers/toggle-visibility"
                            method="POST"
                            class="inline-block"
                        >
                            <input
                                type="hidden"
                                name="id"
                                value={customer.customer_id}
                            />
                            <button
                                type="button"
                                class={`confirm-trigger-btn p-2 rounded-lg border transition-colors ${
                                    customer.isVisible
                                        ? "bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-400 border-emerald-500/20"
                                        : "bg-neutral-800 hover:bg-neutral-700 text-neutral-400 border-neutral-700"
                                }`}
                                title={customer.isVisible ? "Ocultar" : "Mostrar"}
                                data-title={customer.isVisible ? "Ocultar proyecto" : "Mostrar proyecto"}
                                data-desc={customer.isVisible ? "¿Estás seguro de que deseas ocultar este proyecto? Ya no aparecerá en la web pública." : "¿Estás seguro de que deseas mostrar este proyecto? Estará visible para todos los visitantes."}
                                data-btn-color="emerald"
                            >
                                {customer.isVisible ? (
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                    </svg>
                                ) : (
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
                                    </svg>
                                )}
                            </button>
                        </form>
                        <a
                            href={`/proyectos/${customer.customer_id}`}
                            target="_blank"
                            class="p-2 bg-white/5 hover:bg-white/10 rounded-lg border border-white/10 transition-colors text-white"
                            title="Ver en vivo"
                        >
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                            </svg>
                        </a>
                        <a
                            href={`/admin/edit/${customer.customer_id}`}
                            class="p-2 bg-indigo-600/20 hover:bg-indigo-600/30 text-indigo-300 rounded-lg border border-indigo-500/20 transition-colors"
                            title="Editar"
                        >
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                            </svg>
                        </a>
                        <button
                            data-id={customer.customer_id}
                            class="delete-btn p-2 bg-red-500/10 hover:bg-red-500/20 text-red-400 rounded-lg border border-red-500/20 transition-colors"
                            title="Eliminar"
                            data-title="Eliminar proyecto"
                            data-desc="¿Estás seguro de que deseas eliminar permanentemente este proyecto del portfolio? Esta acción no se puede deshacer."
                            data-btn-color="red"
                        >
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                            </svg>
                        </button>
                    </div>
                </div>
            ))
        }
    </div></div>

<!-- Custom Unified Confirmation Dialog -->
<dialog
    id="customConfirmDialog"
    class="fixed inset-0 m-auto bg-neutral-900/95 backdrop-blur-sm border border-white/10 text-white rounded-2xl p-0 shadow-2xl max-w-sm w-full overflow-hidden z-[110]"
>
    <div class="p-6 text-center space-y-4">
        <div id="confirmIconContainer" class="w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-2 bg-indigo-500/10 text-indigo-400">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
        </div>
        <h3 id="confirmTitle" class="text-lg font-bold">¿Confirmar acción?</h3>
        <p id="confirmDescription" class="text-neutral-400 text-xs leading-relaxed max-w-xs mx-auto">
            Por favor confirma si estás de acuerdo con realizar este cambio.
        </p>
        <footer class="flex gap-3 justify-center pt-2">
            <button
                type="button"
                id="cancelConfirmBtn"
                class="px-5 py-2.5 rounded-xl bg-neutral-800 hover:bg-neutral-700 text-neutral-300 font-medium text-xs transition-colors border border-white/5"
            >
                Cancelar
            </button>
            <button
                type="button"
                id="submitConfirmBtn"
                class="px-5 py-2.5 rounded-xl font-medium text-xs transition-colors text-white"
            >
                Confirmar
            </button>
        </footer>
    </div>
</dialog>

<!-- Hidden Delete Form for Portfolio Projects -->
<form action="/api/customers/delete" method="POST" id="confirmDeleteForm" class="hidden">
    <input type="hidden" name="id" id="confirmDeleteId" value="" />
</form>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const dialog = document.getElementById("customConfirmDialog") as HTMLDialogElement;
        const cancelBtn = document.getElementById("cancelConfirmBtn");
        const submitBtn = document.getElementById("submitConfirmBtn");
        
        const confirmTitle = document.getElementById("confirmTitle");
        const confirmDesc = document.getElementById("confirmDescription");
        const iconContainer = document.getElementById("confirmIconContainer");
        
        const deleteForm = document.getElementById("confirmDeleteForm") as HTMLFormElement;
        const deleteIdInput = document.getElementById("confirmDeleteId") as HTMLInputElement;
        
        let pendingForm: HTMLFormElement | null = null;

        document.addEventListener("click", (e) => {
            const target = e.target as HTMLElement;
            
            // 1. Toggle visibility trigger
            const visibilityBtn = target.closest(".confirm-trigger-btn") as HTMLElement | null;
            if (visibilityBtn) {
                e.preventDefault();
                pendingForm = visibilityBtn.closest("form");
                
                const title = visibilityBtn.getAttribute("data-title") || "";
                const desc = visibilityBtn.getAttribute("data-desc") || "";
                
                if (confirmTitle) confirmTitle.textContent = title;
                if (confirmDesc) confirmDesc.textContent = desc;
                
                if (submitBtn) {
                    submitBtn.className = "px-5 py-2.5 rounded-xl font-medium text-xs transition-all text-white ";
                    submitBtn.classList.add("bg-emerald-600", "hover:bg-emerald-500", "shadow-lg", "shadow-emerald-500/20");
                }
                if (iconContainer) {
                    iconContainer.className = "w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-2 bg-emerald-500/10 text-emerald-400";
                    iconContainer.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>`;
                }
                
                dialog?.showModal();
                return;
            }
            
            // 2. Delete trigger
            const deleteBtn = target.closest(".delete-btn") as HTMLElement | null;
            if (deleteBtn) {
                e.preventDefault();
                const id = deleteBtn.getAttribute("data-id") || "";
                if (deleteIdInput) {
                    deleteIdInput.value = id;
                }
                pendingForm = deleteForm;
                
                const title = deleteBtn.getAttribute("data-title") || "";
                const desc = deleteBtn.getAttribute("data-desc") || "";
                
                if (confirmTitle) confirmTitle.textContent = title;
                if (confirmDesc) confirmDesc.textContent = desc;
                
                if (submitBtn) {
                    submitBtn.className = "px-5 py-2.5 rounded-xl font-medium text-xs transition-all text-white ";
                    submitBtn.classList.add("bg-red-600", "hover:bg-red-500", "shadow-lg", "shadow-red-500/20");
                }
                if (iconContainer) {
                    iconContainer.className = "w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-2 bg-red-500/10 text-red-500";
                    iconContainer.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>`;
                }
                
                dialog?.showModal();
            }
        });

        cancelBtn?.addEventListener("click", () => {
            dialog?.close();
            pendingForm = null;
        });

        submitBtn?.addEventListener("click", () => {
            if (pendingForm) {
                dialog?.close();
                pendingForm.submit();
            }
        });
        
        // Close if click outside dialog
        dialog?.addEventListener("click", (e) => {
            if (e.target === dialog) {
                dialog.close();
                pendingForm = null;
            }
        });
    });
</script>

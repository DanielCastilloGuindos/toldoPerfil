            <div class="bg-gradient-to-br from-purple-500 to-pink-600 border-0 shadow-lg shadow-purple-500/20 text-white rounded-2xl p-5 hover:scale-105 transition-transform flex items-center justify-between cursor-pointer group">
                <div>
                    <span class="text-purple-100 text-[10px] uppercase font-bold tracking-wider opacity-90">Contactos</span>
                    <p class="text-3xl font-bold mt-1 text-white">{contactClicks}</p>
                    <span class="text-[9px] text-purple-200/80 block mt-2">Formularios</span>
                </div>
                <div class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center group-hover:scale-110 transition-transform">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />

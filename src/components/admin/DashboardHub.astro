            </div>

            <div class="bg-gradient-to-br from-rose-500 to-red-600 border-0 shadow-lg shadow-rose-500/20 text-white rounded-2xl p-5 hover:scale-105 transition-transform flex items-center justify-between cursor-pointer group">

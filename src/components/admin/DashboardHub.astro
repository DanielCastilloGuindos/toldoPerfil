---
import { db } from "@/db/client";
import { Customers, Analytics, Blogs } from "@/db/schema";
import { desc, eq } from "drizzle-orm";

// Fetch Stats
const analyticsData = await db.select().from(Analytics);
const totalViews = analyticsData.filter((a) => a.type === "page_view").length;
const contactClicks = analyticsData.filter(
    (a) => a.type === "contact_click",
).length;

// -- Top Visited Calculation -- //
const pageViews = analyticsData.filter(
    (a) =>
        a.type === "page_view" &&
        a.data &&
        ((a.data as any).path?.startsWith("/productsDB/") || (a.data as any).path?.startsWith("/proyectos/")),
);
const viewCounts: Record<string, number> = {};

pageViews.forEach((view) => {
    const path = (view.data as any).path;
    const pathId = path.split("/").pop();
    const id = pathId?.split('-')[0];
    if (id && !isNaN(Number(id))) {
        viewCounts[id] = (viewCounts[id] || 0) + 1;
    }
});

// Sort by count desc
const sortedIds = Object.entries(viewCounts)
    .sort(([, a], [, b]) => b - a)
    .slice(0, 5) // Top 5
    .map(([id]) => Number(id));

// Fetch customer details for top 5 (only if there are views)
let topVisitedCustomers: any[] = [];
if (sortedIds.length > 0) {
    const allCustomers = await db.select().from(Customers);
    topVisitedCustomers = sortedIds
        .map((id) => {
            const customer = allCustomers.find((c) => c.customer_id === id);
            return customer ? { ...customer, views: viewCounts[id] } : null;
        })
        .filter(Boolean);
}

const customersData = await db.select().from(Customers);
const totalEnterprises = customersData.filter(
    (c) => c.category === "enterprise",
).length;
const totalPrivate = customersData.filter(
    (c) => c.category === "privateCustomer",
).length;

const blogsData = await db.select().from(Blogs);
const totalBlogs = blogsData.length;
---


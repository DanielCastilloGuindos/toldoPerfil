                    <span class="text-rose-100 text-[10px] uppercase font-bold tracking-wider opacity-90">Preguntas FAQ</span>
                    <p class="text-3xl font-bold mt-1 text-white">
                        {analyticsData.filter((a) => a.type === "faq_click").length}
                    </p>
                    <span class="text-[9px] text-rose-200/80 block mt-2">Preguntas leídas</span>
                </div>
                <div class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center group-hover:scale-110 transition-transform">

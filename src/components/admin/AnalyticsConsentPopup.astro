---
const hasSession = Astro.cookies.has("admin_session");
const hasDisableAnalyticsCookie = Astro.cookies.has("disable_analytics");
---

{hasSession && !hasDisableAnalyticsCookie && (
	<div id="analytics-cookie-popup" class="fixed inset-0 z-[9999] flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-300">
		<div class="relative w-full max-w-md p-6 bg-neutral-900 border border-white/10 rounded-2xl shadow-2xl backdrop-blur-xl scale-95 opacity-0 transition-all duration-300 transform" id="popup-content">
			<h3 class="text-base font-bold text-white mb-2">Excluir tus visitas de las analíticas</h3>
			<p class="text-xs text-neutral-300 leading-relaxed mb-6">
				Hemos detectado que estás en el panel de administración. ¿Deseas guardar una cookie para excluir tu navegador de las estadísticas de visitas y clics de la web durante 1 año?
			</p>
			<div class="flex justify-end gap-3">
				<button id="decline-analytics-btn" class="px-4 py-2.5 bg-white/5 hover:bg-white/10 text-white rounded-xl text-xs font-semibold cursor-pointer transition-colors">
					No, gracias
				</button>
				<button id="accept-analytics-btn" class="px-4 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl text-xs font-bold shadow-lg shadow-indigo-500/20 cursor-pointer transition-all">
					Activar Exclusión
				</button>
			</div>
		</div>
	</div>
)}

<script>
	function initAnalyticsPopup() {
		const popup = document.getElementById("analytics-cookie-popup");
		const content = document.getElementById("popup-content");
		const acceptBtn = document.getElementById("accept-analytics-btn");
		const declineBtn = document.getElementById("decline-analytics-btn");

		if (!popup || !content || !acceptBtn || !declineBtn) return;

		// Check if dismissed in this session
		if (sessionStorage.getItem("analytics_popup_dismissed") === "true") {
			return;
		}

		// Helper to check cookie client-side
		const hasDisableCookie = document.cookie.split("; ").some(c => c.startsWith("disable_analytics="));
		if (hasDisableCookie) {
			return;
		}

		// Show popup with animation
		popup.classList.remove("pointer-events-none");
		popup.classList.add("opacity-100");
		content.classList.remove("scale-95", "opacity-0");
		content.classList.add("scale-100", "opacity-100");

		const closePopup = () => {
			content.classList.remove("scale-100", "opacity-100");
			content.classList.add("scale-95", "opacity-0");
			popup.classList.remove("opacity-100");
			popup.classList.add("pointer-events-none");
		};

		acceptBtn.addEventListener("click", () => {
			// Set cookie for 1 year (365 days)
			const oneYearInSeconds = 60 * 60 * 24 * 365;
			const secureFlag = window.location.protocol === "https:" ? "; secure" : "";
			document.cookie = `disable_analytics=true; path=/; max-age=${oneYearInSeconds}; SameSite=Lax${secureFlag}`;
			closePopup();
		});

		declineBtn.addEventListener("click", () => {
			sessionStorage.setItem("analytics_popup_dismissed", "true");
			closePopup();
		});
	}

	// Run on load and on page transition (Astro ClientRouter)
	document.addEventListener("DOMContentLoaded", initAnalyticsPopup);
	document.addEventListener("astro:page-load", initAnalyticsPopup);
</script>

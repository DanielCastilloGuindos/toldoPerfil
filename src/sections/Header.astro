---
import HamburgerButton from "@/components/HamburgerButton.astro";
import { Image } from "astro:assets";

const pages = [
	{ name: "Nosotros ", href: "#about-us" },
	{ name: "Marcas y Franquiciados", href: "#brandsAndFranchises" },
	{ name: "Comunidades", href: "#communities" },
	{ name: "Particulares", href: "#privatecustomers" },
	{ name: "FAQ", href: "#faq" },
	{
		name: "Tu presupuesto",
		href: "#contact-us",
		buttonStyles: true,
		disabled: false,
	},
].map((page) => ({
	...page,
	active: Astro.url.pathname === page.href,
}));


const { isVisibleNav } = Astro.props
---

<header
	id="menu"
	class="group py-2 px-4 sm:py-5 sm:px-8 flex justify-between items-center align-middle font-bold leading-tight text-sx font-sans sticky top-0 left-0 z-20 bg-white border-0 border-b"
	transition:persist
>
	<a href="/" class="py-3 text-lg sm:text-base z-10" aria-label="Enlace a la página principal de Toldo Perfil">
		<span class="hidden" aria-hidden="true">Toldo Perfil</span>
		<Image
			src='/img/logo.png'
			alt='Logo de ToldoPerfil'
			width='128'
			height='100'
		/>
	</a>

	<nav
		class:list={[
		"inset-0 sm:relative hidden sm:flex flex-col sm:flex-row justify-center items-center gap-6 text-[14px] bg-white sm:bg-transparent group-[.open]:fixed group-[.open]:sm:relative group-[.open]:flex z-10",
		{
			'hidden sm:hidden group-[.open]:hidden': !isVisibleNav
		},
	]}
	>
		{
			pages.map(({ disabled, name, href, active, buttonStyles }, key) => (
				<>
					<a
						href={href}
						aria-label=`Enlace a la sección "${name}"`
						class:list={[
							"py-3 px-5 sm:opacity-100 transition-all duration-300 sm:hover:-translate-y-0.5 nav-link",
							{ button: buttonStyles },
							{ "pointer-events-none": disabled },
							{ "current-page": active },
						]}
						id={`nav-link-${key}`}
					>
						{name}
					</a>
				</>
			))
		}
	</nav>

	<HamburgerButton class:list={[
		{
			'hidden sm:hidden group-[.open]:hidden': !isVisibleNav
		},
	]}/>
</header>

<style is:global>
html {
	scroll-behavior: smooth;
}
</style>

<style>
	/* Estado inicial oculto en móvil con desplazamiento vertical */
	@media (max-width: 639px) {
		#menu nav a {
			opacity: 0;
			transform: translateY(20px);
			transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1), transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
		}

		/* Aparición escalonada cuando el menú móvil se abre */
		#menu.open nav a {
			opacity: 1;
			transform: translateY(0);
		}

		/* Delays escalonados para cada una de las opciones */
		#menu.open nav a:nth-child(1) { transition-delay: 100ms; }
		#menu.open nav a:nth-child(2) { transition-delay: 175ms; }
		#menu.open nav a:nth-child(3) { transition-delay: 250ms; }
		#menu.open nav a:nth-child(4) { transition-delay: 325ms; }
		#menu.open nav a:nth-child(5) { transition-delay: 400ms; }
		#menu.open nav a:nth-child(6) { transition-delay: 475ms; }
	}
</style>

<script>
	import { $, $$ } from "@/consts/dom-selector";

	const initHeaderBehavior = () => {
		const menu = $('#menu');
		const hamburgerButton = $('#HamburgerButton');
		
		document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
			// Remove existing listeners by replacing the element or just redefining it (it's safe to add since we target new anchor elements, but if they persist we need care. Here, anchors are inside the navigation of Header which has transition:persist. So we must be careful not to double-add event listeners if they persist!)
			// A clean way to avoid double-adding is to clone the anchor or check a custom data attribute:
			if (anchor.getAttribute('data-has-scroll-listener')) return;
			anchor.setAttribute('data-has-scroll-listener', 'true');

			anchor.addEventListener("click", function (e) {
				e.preventDefault();
				
				menu?.classList.remove('open');
				hamburgerButton?.classList.remove('open');
				
				const targetId = this.getAttribute("href");
				
				if (targetId && $(targetId)) {
					const targetElement = $(targetId);
					const targetOffset = targetElement.offsetTop;
					// Header height offset (approx 80px-100px)
					const headerOffset = 100; 
					const elementPosition = targetOffset - headerOffset;

					window.scrollTo({
						top: elementPosition,
						behavior: "smooth",
					});
				}
			});
		});
	};

	document.addEventListener("astro:page-load", initHeaderBehavior);
</script>
